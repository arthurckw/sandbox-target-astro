---
export const prerender = true;
import BaseLayout from '../../../layouts/BaseLayout.astro';
import DocsSidebar from '../../../components/DocsSidebar.astro';

// Auto-updates on every deploy
const lastUpdated = new Date().toISOString().split('T')[0];

const faqs = [
  { q: "How do I install the HumanJudge Python SDK?",
    a: "pip install grandjury. Requires Python 3.8+. The package is published on PyPI as 'grandjury'." },
  { q: "Do I need an API token?",
    a: "Get a free token at humanjudge.com/spectator-hub → Your API token. Public leaderboards work without a token; vote-level data requires one." },
  { q: "Does the SDK work with pandas?",
    a: "Yes. Every ResultSet has a .to_pandas() method. ModelList objects also support .to_pandas(). Designed for Jupyter and data analysis workflows." },
  { q: "Is the SDK lazy or eager?",
    a: "Lazy by default. Calls like .votes() or .leaderboard() return a ResultSet that doesn't fetch anything until you iterate, slice, or call .to_pandas(). Use .fetch_all() to eagerly load everything." },
  { q: "How do I filter votes by model?",
    a: "Pass model=['slug-1', 'slug-2'] to .votes(). The SDK handles pagination automatically across the filtered set." },
  { q: "What data is in a vote record?",
    a: "trace_id, model_slug, model_name, verdict (pass/flag), feedback (reviewer text), flag_category (when flagged), evaluator_id, timestamp. 8 fields per vote." },
  { q: "Can I run this in a notebook?",
    a: "Yes — the SDK is built for Jupyter. Lazy ResultSets, .head(n) for previews, .to_pandas() for DataFrames, and rich repr for clean notebook output." },
  { q: "How fresh is the data?",
    a: "Real-time. Each call hits the live API. New reviews show up immediately." }
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    "name": "HumanJudge Python SDK — Query Real Human AI Evaluations from Jupyter and Scripts",
    "url": "https://humanjudge.com/docs/pulse/python-sdk",
    "description": "pip install grandjury. Lazy ResultSets, pandas integration, model filtering. Query 16,668+ blind human AI evaluations from Python — built for data analysis and ML workflows.",
    "datePublished": "2026-04-23",
    "dateModified": lastUpdated,
    "author": { "@type": "Organization", "name": "HumanJudge", "url": "https://humanjudge.com" },
    "publisher": { "@type": "Organization", "name": "HumanJudge", "url": "https://humanjudge.com" },
    "mainEntityOfPage": "https://humanjudge.com/docs/pulse/python-sdk"
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareSourceCode",
    "name": "grandjury",
    "programmingLanguage": "Python",
    "codeRepository": "https://pypi.org/project/grandjury/",
    "description": "Python SDK for querying HumanJudge human AI evaluation data. Lazy ResultSet, pandas integration, model filtering."
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map(f => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a }
    }))
  }
];
---

<BaseLayout
  title="HumanJudge Python SDK — pip install grandjury | Query Human AI Evaluations | HumanJudge"
  description="Python SDK for human AI evaluation data. Lazy ResultSet, pandas integration, multi-model filtering. 16,668+ blind reviews of 15 AI models. pip install grandjury."
  currentPath="/docs"
  jsonLd={jsonLd}
>
  <div class="min-h-screen bg-surface">
    <div class="bg-surface-elevated border-b border-border-subtle">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <nav class="text-sm text-secondary mb-4">
          <a href="/docs" class="hover:text-primary">Docs</a>
          <span class="mx-2">/</span>
          <a href="/docs" class="hover:text-primary">Pulse</a>
          <span class="mx-2">/</span>
          <span class="text-primary">Python SDK</span>
        </nav>
        <h1 class="text-4xl font-bold text-primary mb-4">Pull human AI evaluation data into Python — for notebooks, scripts, and ML pipelines</h1>
        <p class="text-xl text-secondary max-w-3xl">
          <code class="text-accent bg-surface-elevated px-2 py-0.5 rounded">pip install grandjury</code>. Query 16,668+ blind human reviews of 15 AI models. Lazy ResultSets, pandas integration, multi-model filtering — built for Jupyter and data analysis.
        </p>
      </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="grid md:grid-cols-3 gap-8">
        <DocsSidebar currentPath="/docs/pulse/python-sdk" />

        <div class="md:col-span-2 prose prose-invert max-w-none">

          <!-- Hook -->
          <section class="mb-10">
            <p class="text-secondary text-lg mb-4">
              You're a data scientist or ML engineer trying to figure out which AI model actually performs best for your use case. Most "evaluation" you can find online is automated benchmarks that agree with themselves.
            </p>
            <p class="text-secondary mb-4">
              The grandjury SDK gives you <strong class="text-primary">16,668 blind human evaluations of 15 AI models</strong> as pandas DataFrames in 3 lines of code. Built for Jupyter — lazy ResultSets, auto-pagination, slicing, multi-model filtering. No more curling JSON or wrangling pagination tokens.
            </p>
          </section>

          <!-- Who this is for -->
          <section class="mb-10">
            <h2 class="text-2xl font-bold text-primary mb-4">Who this is for</h2>
            <ul class="text-secondary space-y-1">
              <li>• <strong class="text-primary">Data scientists</strong> doing exploratory analysis on AI model quality in Jupyter</li>
              <li>• <strong class="text-primary">ML engineers</strong> building eval pipelines that need a human-grounded baseline</li>
              <li>• <strong class="text-primary">Researchers</strong> studying disagreement patterns in AI evaluation</li>
              <li>• <strong class="text-primary">Anyone</strong> who'd rather call a Python function than hit a REST API by hand</li>
            </ul>
          </section>

          <!-- Install -->
          <section class="mb-10">
            <h2 class="text-2xl font-bold text-primary mb-4">Install</h2>
            <div class="bg-surface-elevated border border-border-subtle rounded-lg overflow-hidden mb-4">
              <div class="bg-surface px-4 py-2 border-b border-border-subtle">
                <span class="text-sm text-secondary">Terminal</span>
              </div>
              <pre class="p-4 overflow-x-auto"><code class="text-sm text-primary">pip install grandjury</code></pre>
            </div>
            <p class="text-tertiary text-sm">Python 3.8+. <a href="https://pypi.org/project/grandjury/" class="text-accent hover:underline" target="_blank" rel="noopener noreferrer">Package on PyPI →</a></p>
          </section>

          <!-- Quick start -->
          <section class="mb-10">
            <h2 class="text-2xl font-bold text-primary mb-4">Quick start (3 lines)</h2>
            <div class="bg-surface-elevated border border-border-subtle rounded-lg overflow-hidden mb-4">
              <div class="bg-surface px-4 py-2 border-b border-border-subtle">
                <span class="text-sm text-secondary">Python</span>
              </div>
              <pre class="p-4 overflow-x-auto"><code class="text-sm text-primary">{`from grandjury import GJClient

gj = GJClient(token="gj_pat_...")

# Leaderboard — pass rates, flags, rankings as pandas
lb = gj.benchmarks.leaderboard("7a97ef08-3d89-42c5-a4db-f6b43b4700ca")
df_lb = lb.to_pandas()
print(df_lb)`}</code></pre>
            </div>
            <div class="bg-surface-elevated border border-border-subtle rounded-lg p-4">
              <p class="text-secondary text-sm">Get your API token at <a href="https://humanjudge.com/spectator-hub" class="text-accent hover:underline">Pulse Check → Your API token</a>. Public leaderboards work without a token; vote-level data requires one. See <a href="/docs/authentication" class="text-accent hover:underline">Authentication</a>.</p>
            </div>
          </section>

          <!-- Common workflows -->
          <section class="mb-10">
            <h2 class="text-2xl font-bold text-primary mb-4">Common workflows</h2>

            <h3 class="text-lg font-semibold text-primary mt-6 mb-2">List arena models</h3>
            <div class="bg-surface-elevated border border-border-subtle rounded-lg overflow-hidden mb-6">
              <div class="bg-surface px-4 py-2 border-b border-border-subtle"><span class="text-sm text-secondary">Python</span></div>
              <pre class="p-4 overflow-x-auto"><code class="text-sm text-primary">{`models = gj.arena("7a97ef08-...").models()
df_models = models.to_pandas()
print(models)  # ModelList(15 models)`}</code></pre>
            </div>

            <h3 class="text-lg font-semibold text-primary mt-6 mb-2">Fetch votes (with model filter)</h3>
            <p class="text-secondary mb-2">Lazy by default. Auto-paginates. Filter by one or many model slugs.</p>
            <div class="bg-surface-elevated border border-border-subtle rounded-lg overflow-hidden mb-6">
              <div class="bg-surface px-4 py-2 border-b border-border-subtle"><span class="text-sm text-secondary">Python</span></div>
              <pre class="p-4 overflow-x-auto"><code class="text-sm text-primary">{`v = gj.arena("7a97ef08-...").votes(
    model=["xai-grok-4-1-fast", "xai-grok-4"]
)

print(v)  # ResultSet(not loaded)

df = v.to_pandas()  # Loads all pages
print(df.shape)     # (3166, 8)

# Or iterate lazily
for vote in v:
    if not vote["verdict"]:
        print(vote["feedback"])`}</code></pre>
            </div>

            <h3 class="text-lg font-semibold text-primary mt-6 mb-2">Slicing without loading everything</h3>
            <div class="bg-surface-elevated border border-border-subtle rounded-lg overflow-hidden mb-6">
              <div class="bg-surface px-4 py-2 border-b border-border-subtle"><span class="text-sm text-secondary">Python</span></div>
              <pre class="p-4 overflow-x-auto"><code class="text-sm text-primary">{`results = gj.arena("7a97ef08-...").votes()

# Nothing loaded yet
print(results)  # ResultSet(not loaded)

# Just the first 10 rows
df_preview = results.head(10).to_pandas()

# Now eagerly load all pages
results.fetch_all()
df_all = results.to_pandas()`}</code></pre>
            </div>
          </section>

          <!-- Full example -->
          <section class="mb-10">
            <h2 class="text-2xl font-bold text-primary mb-4">Full Jupyter notebook example</h2>
            <p class="text-secondary mb-4">A typical workflow: leaderboard overview → enrolled models → deep-dive on one model → flag pattern analysis.</p>
            <div class="bg-surface-elevated border border-border-subtle rounded-lg overflow-hidden mb-4">
              <div class="bg-surface px-4 py-2 border-b border-border-subtle"><span class="text-sm text-secondary">Jupyter Notebook</span></div>
              <pre class="p-4 overflow-x-auto"><code class="text-sm text-primary">{`from grandjury import GJClient
import pandas as pd

gj = GJClient(token="gj_pat_...")
arena_id = "7a97ef08-3d89-42c5-a4db-f6b43b4700ca"

# 1. Leaderboard overview
lb = gj.benchmarks.leaderboard(arena_id)
df_lb = lb.to_pandas()
print(df_lb[["model_name", "pass_rate", "total_votes", "flag_count"]])

# 2. Which models are enrolled?
models = gj.arena(arena_id).models()
print(models)

# 3. Deep dive — Grok votes
grok_votes = gj.arena(arena_id).votes(
    model=["xai-grok-4-1-fast", "xai-grok-4"]
)
df = grok_votes.to_pandas()

# 4. Flag pattern analysis
flags = df[df["verdict"] == False]
print(f"Flag rate: {len(flags)/len(df)*100:.1f}%")
print(flags["feedback"].value_counts().head(10))`}</code></pre>
            </div>
          </section>

          <!-- API reference -->
          <section class="mb-10">
            <h2 class="text-2xl font-bold text-primary mb-4">API reference</h2>
            <div class="bg-surface-elevated border border-border-subtle rounded-lg overflow-hidden">
              <div class="p-4 text-sm text-secondary space-y-3">
                <div>
                  <p class="text-primary font-medium"><code class="text-accent">GJClient(token=None, base_url=None)</code></p>
                  <p class="text-secondary text-sm">Initialize the client. Token is optional for public leaderboard access.</p>
                </div>
                <div class="border-t border-border-subtle pt-3">
                  <p class="text-primary font-medium"><code class="text-accent">gj.benchmarks.leaderboard(arena_id)</code></p>
                  <p class="text-secondary text-sm">Returns <code class="text-accent">ResultSet</code> with model rankings, pass rates, flag counts.</p>
                </div>
                <div class="border-t border-border-subtle pt-3">
                  <p class="text-primary font-medium"><code class="text-accent">gj.arena(arena_id).models()</code></p>
                  <p class="text-secondary text-sm">Returns <code class="text-accent">ModelList</code> with enrolled model metadata.</p>
                </div>
                <div class="border-t border-border-subtle pt-3">
                  <p class="text-primary font-medium"><code class="text-accent">gj.arena(arena_id).votes(model=None, from_date=None, to_date=None, limit=1000, offset=0)</code></p>
                  <p class="text-secondary text-sm">Returns <code class="text-accent">ResultSet</code> with vote-level data. <code class="text-accent">model</code> accepts a string or list of slugs.</p>
                </div>
                <div class="border-t border-border-subtle pt-3">
                  <p class="text-primary font-medium"><code class="text-accent">ResultSet.to_pandas()</code></p>
                  <p class="text-secondary text-sm">Convert to DataFrame. Fetches all pages if not already loaded.</p>
                </div>
                <div class="border-t border-border-subtle pt-3">
                  <p class="text-primary font-medium"><code class="text-accent">ResultSet.fetch_all()</code></p>
                  <p class="text-secondary text-sm">Load all pages eagerly.</p>
                </div>
                <div class="border-t border-border-subtle pt-3">
                  <p class="text-primary font-medium"><code class="text-accent">ResultSet.head(n)</code></p>
                  <p class="text-secondary text-sm">Return first n rows as a new ResultSet.</p>
                </div>
              </div>
            </div>
          </section>

          <!-- FAQ -->
          <section class="mb-10">
            <h2 class="text-2xl font-bold text-primary mb-4">FAQ</h2>
            <div class="space-y-3">
              {faqs.map((f) => (
                <details class="bg-surface-elevated border border-border-subtle rounded-lg p-4 group">
                  <summary class="cursor-pointer text-primary font-medium list-none flex items-center justify-between">
                    <span>{f.q}</span>
                    <span class="text-tertiary group-open:rotate-180 transition-transform">▾</span>
                  </summary>
                  <p class="text-secondary text-sm mt-3">{f.a}</p>
                </details>
              ))}
            </div>
          </section>

          <!-- Cross-links -->
          <section class="mb-10">
            <h2 class="text-2xl font-bold text-primary mb-4">Want this in your other tools?</h2>
            <div class="grid sm:grid-cols-2 gap-3">
              <a href="/docs/pulse/chatgpt" class="bg-surface-elevated border border-border-subtle rounded-lg p-4 hover:border-accent/50 transition-colors group block">
                <h3 class="font-semibold text-primary group-hover:text-accent">ChatGPT →</h3>
                <p class="text-secondary text-sm">Free GPT in the GPT Store. No setup.</p>
              </a>
              <a href="/docs/pulse/claude-desktop" class="bg-surface-elevated border border-border-subtle rounded-lg p-4 hover:border-accent/50 transition-colors group block">
                <h3 class="font-semibold text-primary group-hover:text-accent">Claude Desktop →</h3>
                <p class="text-secondary text-sm">MCP connector with native Claude tools.</p>
              </a>
              <a href="/docs/pulse/claude-code" class="bg-surface-elevated border border-border-subtle rounded-lg p-4 hover:border-accent/50 transition-colors group block">
                <h3 class="font-semibold text-primary group-hover:text-accent">Claude Code →</h3>
                <p class="text-secondary text-sm">Same MCP, inside VS Code or the CLI.</p>
              </a>
              <a href="/docs/authentication" class="bg-surface-elevated border border-border-subtle rounded-lg p-4 hover:border-accent/50 transition-colors group block">
                <h3 class="font-semibold text-primary group-hover:text-accent">Authentication →</h3>
                <p class="text-secondary text-sm">Generate and manage your API token.</p>
              </a>
            </div>
          </section>

          <p class="text-xs text-tertiary mt-12 pt-6 border-t border-border-subtle">Last updated: {lastUpdated} · SDK on <a href="https://pypi.org/project/grandjury/" class="text-accent hover:underline" target="_blank" rel="noopener noreferrer">PyPI</a> · Data refreshes live from humanjudge.com</p>

        </div>
      </div>
    </div>
  </div>
</BaseLayout>
