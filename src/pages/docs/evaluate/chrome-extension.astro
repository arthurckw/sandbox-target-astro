---
export const prerender = true;
import BaseLayout from '../../../layouts/BaseLayout.astro';
import DocsSidebar from '../../../components/DocsSidebar.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "name": "HumanJudge Chrome Extension — Review AI Outputs",
  "url": "https://humanjudge.com/docs/evaluate/chrome-extension",
  "description": "Install the HumanJudge Chrome Extension to review AI outputs as you browse. Earn XP, build your evaluator profile, and contribute to human evaluation data.",
  "publisher": { "@type": "Organization", "name": "HumanJudge", "url": "https://humanjudge.com" }
};
---

<BaseLayout
  title="Chrome Extension — Review AI Outputs | HumanJudge Docs"
  description="Review AI outputs as you browse with the HumanJudge Chrome Extension. Earn XP, flag quality issues, and build your expert evaluator profile."
  currentPath="/docs"
  jsonLd={jsonLd}
>
  <div class="min-h-screen bg-surface">
    <div class="bg-surface-elevated border-b border-border-subtle">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <nav class="text-sm text-secondary mb-4">
          <a href="/docs" class="hover:text-primary">Docs</a>
          <span class="mx-2">/</span>
          <a href="/docs" class="hover:text-primary">Evaluate</a>
          <span class="mx-2">/</span>
          <span class="text-primary">Chrome Extension</span>
        </nav>
        <h1 class="text-4xl font-bold text-primary mb-4">Chrome Extension</h1>
        <p class="text-xl text-secondary max-w-3xl">
          Review AI outputs as you browse. Earn XP and build your expert evaluator profile.
        </p>
      </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="grid md:grid-cols-3 gap-8">
        <DocsSidebar currentPath="/docs/evaluate/chrome-extension" />

        <div class="md:col-span-2 prose prose-invert max-w-none">
          <p class="text-secondary mb-6">Documentation coming soon. In the meantime, visit <a href="/products/for-reviewers" class="text-accent hover:underline">Judge AI</a> to get started as a reviewer.</p>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
