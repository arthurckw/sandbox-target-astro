---
export const prerender = true;
import BaseLayout from '../../../layouts/BaseLayout.astro';
import DocsSidebar from '../../../components/DocsSidebar.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "name": "HumanJudge Arenas — Create AI Evaluation Benchmarks",
  "url": "https://humanjudge.com/docs/evaluate/arenas",
  "description": "Create custom AI evaluation arenas. Define questions, enroll AI models, and get human feedback on your AI's performance.",
  "publisher": { "@type": "Organization", "name": "HumanJudge", "url": "https://humanjudge.com" }
};
---

<BaseLayout
  title="Arenas — Create AI Evaluation Benchmarks | HumanJudge Docs"
  description="Create custom evaluation arenas for AI models. Define questions, enroll models from OpenRouter, set budgets, and get blind human reviews."
  currentPath="/docs"
  jsonLd={jsonLd}
>
  <div class="min-h-screen bg-surface">
    <div class="bg-surface-elevated border-b border-border-subtle">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <nav class="text-sm text-secondary mb-4">
          <a href="/docs" class="hover:text-primary">Docs</a>
          <span class="mx-2">/</span>
          <a href="/docs" class="hover:text-primary">Evaluate</a>
          <span class="mx-2">/</span>
          <span class="text-primary">Arenas</span>
        </nav>
        <h1 class="text-4xl font-bold text-primary mb-4">Arenas</h1>
        <p class="text-xl text-secondary max-w-3xl">
          Create custom evaluation benchmarks for AI models. Define questions, enroll models, and get blind human reviews.
        </p>
      </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="grid md:grid-cols-3 gap-8">
        <DocsSidebar currentPath="/docs/evaluate/arenas" />

        <div class="md:col-span-2 prose prose-invert max-w-none">
          <p class="text-secondary mb-6">Documentation coming soon. In the meantime, visit <a href="/developer-hub" class="text-accent hover:underline">Developer Hub</a> to create your first arena.</p>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
