<!-- ─────────────────────────────────────────────────────────────────────────
     Tab switcher — vanilla JS, no framework.
     Highlights active tab button + shows only the matching panel.
     Also updates the URL hash so #python / #node / #endpoint / #nocode
     deep-links land on the right tab.
     ───────────────────────────────────────────────────────────────────── -->
<script is:inline>
  (function () {
    const buttons = Array.from(document.querySelectorAll('.tab-button[data-tab]'));
    const panels  = Array.from(document.querySelectorAll('.tab-panel'));
    if (!buttons.length || !panels.length) return;

    const ACTIVE = 'ring-2 ring-accent border-accent bg-surface';
    const HASH_TO_TAB = { python: 'python', node: 'node', endpoint: 'endpoint', nocode: 'nocode' };

    function activate(tab) {
      buttons.forEach(function (b) {
        var on = b.dataset.tab === tab;
        b.setAttribute('aria-selected', String(on));
        ACTIVE.split(' ').forEach(function (cls) { b.classList.toggle(cls, on); });
      });
      panels.forEach(function (p) {
        p.classList.toggle('hidden', p.id !== 'tab-' + tab);
      });
    }

    buttons.forEach(function (b) {
      b.addEventListener('click', function () {
        var tab = b.dataset.tab;
        activate(tab);
        history.replaceState(null, '', '#' + tab);
      });
    });

    // Boot with URL hash if present, else default to python
    var initial = (window.location.hash || '').replace('#', '');
    activate(HASH_TO_TAB[initial] || 'python');
  })();
</script>
