---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import DocsSidebar from '../../components/DocsSidebar.astro';

const youtubeVideoId = '8NuyQ3OxKmo';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "name": "Get Started — Track Your Model with HumanJudge",
  "url": "https://humanjudge.com/docs/get-started",
  "description":
    "Send your model's inputs and outputs to HumanJudge for human evaluation. Four integration paths: Python SDK, Node.js SDK, register your model endpoint, or a no-code HTTP node from Zapier/n8n/Make.",
  "publisher": { "@type": "Organization", "name": "HumanJudge", "url": "https://humanjudge.com" },
  "about": [
    { "@type": "SoftwareSourceCode", "name": "grandjury (Python)", "codeRepository": "https://pypi.org/project/grandjury/", "programmingLanguage": "Python" },
    { "@type": "SoftwareSourceCode", "name": "@grandjury/sdk (JavaScript)", "codeRepository": "https://www.npmjs.com/package/@grandjury/sdk", "programmingLanguage": "JavaScript" }
  ]
};
---

<BaseLayout
  title="Get Started — Track Your Model | HumanJudge Docs"
  description="Send your model's inputs and outputs to HumanJudge for human evaluation. Four ways: Python SDK, Node.js SDK, register your model endpoint, or no-code via Zapier/n8n/Make."
  currentPath="/docs/get-started"
  jsonLd={jsonLd}
>
  <div class="min-h-screen bg-surface">
    <!-- Docs Header -->
    <div class="bg-surface-elevated border-b border-border-subtle">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <nav class="text-sm text-secondary mb-4">
          <a href="/docs" class="hover:text-primary">Docs</a>
          <span class="mx-2">/</span>
          <span class="text-primary">Get Started</span>
        </nav>
        <h1 class="text-4xl font-bold text-primary mb-4">Get Your Model Tracked</h1>
        <p class="text-xl text-secondary max-w-3xl">
          Send your model's inputs and outputs to HumanJudge. Real humans review them and give you pass/flag verdicts — you see it all in your dashboard.
        </p>
      </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="grid md:grid-cols-3 gap-8">
        <DocsSidebar currentPath="/docs/get-started" />

        <div class="md:col-span-2 space-y-12">

          <!-- ═══════════════════════════════════════════════════════════════ -->
          <!-- VIDEO EMBED                                                     -->
          <!-- ═══════════════════════════════════════════════════════════════ -->
          <section id="watch">
            <h2 class="text-2xl font-bold text-primary mb-4">Watch first (5 min)</h2>
            {youtubeVideoId ? (
              <div class="relative w-full rounded-lg overflow-hidden border border-border-subtle" style="padding-top: 56.25%;">
                <iframe
                  class="absolute inset-0 w-full h-full"
                  src={`https://www.youtube.com/embed/${youtubeVideoId}`}
                  title="Get Started with HumanJudge"
                  frameborder="0"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                  allowfullscreen
                ></iframe>
              </div>
            ) : (
              <div class="bg-surface-elevated border border-border-subtle rounded-lg p-8 text-center">
                <p class="text-secondary">📹 Video walkthrough coming soon.</p>
                <p class="text-tertiary text-sm mt-2">The written guide below has everything you need.</p>
              </div>
            )}
            <div class="mt-4 flex items-center gap-3 text-sm">
              <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-accent/10 text-accent font-semibold text-xs">
                KH
              </div>
              <div class="leading-tight">
                <div class="text-primary font-medium">Kamrul Hasan</div>
                <div class="text-tertiary text-xs">Developer Advocate · HumanJudge</div>
              </div>
            </div>
          </section>

          <!-- ═══════════════════════════════════════════════════════════════ -->
          <!-- 4-STEP FLOW — HIGH-LEVEL ORIENTATION                            -->
          <!-- ═══════════════════════════════════════════════════════════════ -->
          <section id="the-flow">
            <h2 class="text-2xl font-bold text-primary mb-4">The 4 steps</h2>
            <p class="text-secondary mb-6">
              Getting reviewed on HumanJudge is four decisions, each one covered below.
            </p>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
              <div class="bg-surface-elevated border border-border-subtle rounded-lg p-4">
                <div class="text-accent text-xs font-semibold uppercase tracking-wider mb-1">Step 1</div>
                <div class="font-semibold text-primary mb-1">Register</div>
                <div class="text-secondary text-xs">Account + model + API key.</div>
              </div>
              <div class="bg-surface-elevated border border-border-subtle rounded-lg p-4">
                <div class="text-accent text-xs font-semibold uppercase tracking-wider mb-1">Step 2</div>
                <div class="font-semibold text-primary mb-1">Hook it up</div>
                <div class="text-secondary text-xs">Python · Node · endpoint · no-code.</div>
              </div>
              <div class="bg-surface-elevated border border-border-subtle rounded-lg p-4">
                <div class="text-accent text-xs font-semibold uppercase tracking-wider mb-1">Step 3</div>
                <div class="font-semibold text-primary mb-1">Pick eval mode</div>
                <div class="text-secondary text-xs">Public arena or your own project.</div>
              </div>
              <div class="bg-surface-elevated border border-border-subtle rounded-lg p-4">
                <div class="text-accent text-xs font-semibold uppercase tracking-wider mb-1">Step 4</div>
                <div class="font-semibold text-primary mb-1">Configure the observer</div>
                <div class="text-secondary text-xs">How the signal comes back.</div>
              </div>
            </div>
          </section>

          <!-- ═══════════════════════════════════════════════════════════════ -->
          <!-- STEP 1 — REGISTER                                               -->
          <!-- ═══════════════════════════════════════════════════════════════ -->
          <section id="step-1">
            <div class="text-accent text-xs font-semibold uppercase tracking-wider mb-1">Step 1</div>
            <h2 class="text-2xl font-bold text-primary mb-4">Register your account and model</h2>
            <p class="text-secondary mb-4">
              Sign in at <a href="https://humanjudge.com/developer-hub" class="text-accent hover:underline">humanjudge.com/developer-hub</a> as a <strong>builder</strong>, then create a model. You'll get two things you need for every other step:
            </p>
            <ol class="space-y-3">
              <li class="flex items-start gap-3">
                <span class="bg-accent/10 text-accent rounded-full w-6 h-6 flex items-center justify-center text-sm font-bold shrink-0 mt-0.5">A</span>
                <div>
                  <p class="text-primary font-medium">Project ID (a UUID)</p>
                  <p class="text-secondary text-sm">
                    Identifies which model the traces belong to. Shown on the model page.
                  </p>
                </div>
              </li>
              <li class="flex items-start gap-3">
                <span class="bg-accent/10 text-accent rounded-full w-6 h-6 flex items-center justify-center text-sm font-bold shrink-0 mt-0.5">B</span>
                <div>
                  <p class="text-primary font-medium">API key</p>
                  <p class="text-secondary text-sm">
                    Starts with <code class="text-accent bg-surface-elevated px-1.5 py-0.5 rounded text-xs">gj_sk_live_</code>. Copy it once — you won't see it again.
                  </p>
                </div>
              </li>
            </ol>
          </section>

          <!-- ═══════════════════════════════════════════════════════════════ -->
          <!-- PICK YOUR PATH — CLICK-AND-SHOW TABS                            -->
          <!-- ═══════════════════════════════════════════════════════════════ -->
          <section id="step-2">
            <div class="text-accent text-xs font-semibold uppercase tracking-wider mb-1">Step 2</div>
            <h2 class="text-2xl font-bold text-primary mb-4">Hook your model up</h2>
            <p class="text-secondary mb-6">Four ways to send us your model's traces. Click one to expand — the others hide.</p>

            <!-- Tab buttons -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 mb-6" role="tablist">
              <button
                type="button"
                data-tab="python"
                class="tab-button bg-surface-elevated border border-border-subtle rounded-lg p-3 text-left hover:border-accent/50 transition-colors"
                role="tab"
                aria-selected="true"
              >
                <div class="text-2xl mb-1">🐍</div>
                <div class="font-semibold text-primary text-sm">Python app</div>
                <div class="text-tertiary text-xs">SDK · one line</div>
              </button>
              <button
                type="button"
                data-tab="node"
                class="tab-button bg-surface-elevated border border-border-subtle rounded-lg p-3 text-left hover:border-accent/50 transition-colors"
                role="tab"
                aria-selected="false"
              >
                <div class="text-2xl mb-1">🟢</div>
                <div class="font-semibold text-primary text-sm">Node.js app</div>
                <div class="text-tertiary text-xs">SDK · TypeScript</div>
              </button>
              <button
                type="button"
                data-tab="endpoint"
                class="tab-button bg-surface-elevated border border-border-subtle rounded-lg p-3 text-left hover:border-accent/50 transition-colors"
                role="tab"
                aria-selected="false"
              >
                <div class="text-2xl mb-1">🌐</div>
                <div class="font-semibold text-primary text-sm">Serve your model</div>
                <div class="text-tertiary text-xs">We call your endpoint</div>
              </button>
              <button
                type="button"
                data-tab="nocode"
                class="tab-button bg-surface-elevated border border-border-subtle rounded-lg p-3 text-left hover:border-accent/50 transition-colors"
                role="tab"
                aria-selected="false"
              >
                <div class="text-2xl mb-1">🔌</div>
                <div class="font-semibold text-primary text-sm">No-code</div>
                <div class="text-tertiary text-xs">Zapier · n8n · Make</div>
              </button>
            </div>

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- TAB PANEL — PYTHON                                            -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <div id="tab-python" class="tab-panel" role="tabpanel">
              <p class="text-secondary mb-6">
                Best when your model runs inside a Python service and you want to wrap existing LLM calls. Works with OpenAI, Anthropic, LiteLLM, LangChain, or your own model.
              </p>

              <h3 class="text-lg font-semibold text-primary mb-3">1. Install</h3>
              <div class="bg-surface-elevated border border-border-subtle rounded-lg overflow-hidden mb-6">
                <div class="bg-surface px-4 py-2 border-b border-border-subtle">
                  <span class="text-sm text-secondary">shell</span>
                </div>
                <pre class="p-4 overflow-x-auto"><code class="text-sm text-primary">pip install grandjury</code></pre>
              </div>

              <h3 class="text-lg font-semibold text-primary mb-3">2. Send a trace after every LLM call</h3>
              <div class="bg-surface-elevated border border-border-subtle rounded-lg overflow-hidden mb-6">
                <div class="bg-surface px-4 py-2 border-b border-border-subtle">
                  <span class="text-sm text-secondary">Python</span>
                </div>
                <pre class="p-4 overflow-x-auto"><code class="text-sm text-primary">{`import grandjury
from openai import OpenAI

gj = grandjury.GrandJury(
    api_key="gj_sk_live_...",       # from your project dashboard
    project_id="00000000-0000-0000-0000-000000000000",
)

client = OpenAI()

def answer(user_prompt: str) -> str:
    resp = client.chat.completions.create(
        model="gpt-4o",
        messages=[{"role": "user", "content": user_prompt}],
    )
    output = resp.choices[0].message.content

    # ⬇ one line — trace is queued and sent asynchronously
    gj.trace(
        name="answer",
        input=user_prompt,
        output=output,
        model="gpt-4o",
    )
    return output`}</code></pre>
              </div>

              <h3 class="text-lg font-semibold text-primary mb-3">Or use the decorator (cleaner)</h3>
              <div class="bg-surface-elevated border border-border-subtle rounded-lg overflow-hidden mb-6">
                <div class="bg-surface px-4 py-2 border-b border-border-subtle">
                  <span class="text-sm text-secondary">Python</span>
                </div>
                <pre class="p-4 overflow-x-auto"><code class="text-sm text-primary">{`@gj.observe(name="answer", model="gpt-4o")
def answer(user_prompt: str) -> str:
    resp = client.chat.completions.create(
        model="gpt-4o",
        messages=[{"role": "user", "content": user_prompt}],
    )
    return resp.choices[0].message.content

# input = user_prompt, output = return value — all captured automatically`}</code></pre>
              </div>

              <p class="text-secondary text-sm">
                Async supported via <code class="text-accent bg-surface-elevated px-1.5 py-0.5 rounded text-xs">await gj.atrace(...)</code>. Context manager via <code class="text-accent bg-surface-elevated px-1.5 py-0.5 rounded text-xs">with gj.span(...)</code>. Never crashes your app — errors log silently.
              </p>
            </div>

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- TAB PANEL — NODE.JS                                          -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <div id="tab-node" class="tab-panel hidden" role="tabpanel">
              <p class="text-secondary mb-6">
                Best when your model runs behind a Node backend — Next.js API routes, Express, Nest, Cloudflare Workers, or a serverless function.
              </p>

              <h3 class="text-lg font-semibold text-primary mb-3">1. Install</h3>
              <div class="bg-surface-elevated border border-border-subtle rounded-lg overflow-hidden mb-6">
                <div class="bg-surface px-4 py-2 border-b border-border-subtle">
                  <span class="text-sm text-secondary">shell</span>
                </div>
                <pre class="p-4 overflow-x-auto"><code class="text-sm text-primary">npm install @grandjury/sdk</code></pre>
              </div>

              <h3 class="text-lg font-semibold text-primary mb-3">2. Send a trace after every LLM call</h3>
              <div class="bg-surface-elevated border border-border-subtle rounded-lg overflow-hidden mb-6">
                <div class="bg-surface px-4 py-2 border-b border-border-subtle">
                  <span class="text-sm text-secondary">TypeScript</span>
                </div>
                <pre class="p-4 overflow-x-auto"><code class="text-sm text-primary">{`import GrandJury from "@grandjury/sdk";
import OpenAI from "openai";

const gj = new GrandJury({
  apiKey: "gj_sk_live_...",       // from your project dashboard
  projectId: "00000000-0000-0000-0000-000000000000",
});

const client = new OpenAI();

export async function answer(userPrompt: string): Promise<string> {
  const resp = await client.chat.completions.create({
    model: "gpt-4o",
    messages: [{ role: "user", content: userPrompt }],
  });
  const output = resp.choices[0].message.content ?? "";

  // ⬇ one call — trace queued and sent async, never throws
  await gj.trace({
    name: "answer",
    input: userPrompt,
    output,
    model: "gpt-4o",
  });

  return output;
}`}</code></pre>
              </div>

              <h3 class="text-lg font-semibold text-primary mb-3">Or wrap the whole function</h3>
              <div class="bg-surface-elevated border border-border-subtle rounded-lg overflow-hidden mb-6">
                <div class="bg-surface px-4 py-2 border-b border-border-subtle">
                  <span class="text-sm text-secondary">TypeScript</span>
                </div>
                <pre class="p-4 overflow-x-auto"><code class="text-sm text-primary">{`const trackedAnswer = gj.observe(answer, {
  name: "answer",
  model: "gpt-4o",
});

// Use it exactly like the original — trace is captured automatically
const reply = await trackedAnswer(userPrompt);`}</code></pre>
              </div>

              <p class="text-secondary text-sm">
                Node.js 18+ (uses native <code class="text-accent bg-surface-elevated px-1.5 py-0.5 rounded text-xs">fetch</code>). Zero runtime dependencies. Errors log to <code class="text-accent bg-surface-elevated px-1.5 py-0.5 rounded text-xs">console.error</code> — your app never crashes.
              </p>
            </div>

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- TAB PANEL — REGISTER YOUR ENDPOINT                           -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <div id="tab-endpoint" class="tab-panel hidden" role="tabpanel">
              <p class="text-secondary mb-6">
                Best when your model already exposes an HTTP endpoint (a hosted inference URL, an internal RAG service, a chat API). You register it once, enroll in a benchmark, and we invoke your endpoint per question — <strong>no SDK on your side</strong>.
              </p>

              <div class="bg-accent/10 border border-accent/20 rounded-lg p-4 mb-6">
                <p class="text-primary text-sm mb-2">
                  <strong>How the request works</strong>
                </p>
                <ul class="text-secondary text-sm list-disc pl-5 space-y-1">
                  <li>We <strong>POST</strong> your endpoint with a JSON body you define (<code class="text-accent bg-surface-elevated px-1.5 py-0.5 rounded text-xs">request_template</code>).</li>
                  <li>The benchmark question is substituted into <code class="text-accent bg-surface-elevated px-1.5 py-0.5 rounded text-xs">{`{{prompt}}`}</code> in your template.</li>
                  <li>Auth header is always <code class="text-accent bg-surface-elevated px-1.5 py-0.5 rounded text-xs">Authorization: Bearer &lt;your apiKey&gt;</code>.</li>
                  <li>We extract the AI response from your JSON reply using a <a href="https://jmespath.org" target="_blank" class="text-accent hover:underline">JMESPath</a> expression (<code class="text-accent bg-surface-elevated px-1.5 py-0.5 rounded text-xs">response_path</code>).</li>
                </ul>
              </div>

              <h3 class="text-lg font-semibold text-primary mb-3">1. Register your endpoint</h3>
              <p class="text-secondary text-sm mb-3">
                In your project dashboard → open your <strong>Model</strong> → <strong>Connections</strong> → paste the fields below. Or via API:
              </p>
              <div class="bg-surface-elevated border border-border-subtle rounded-lg overflow-hidden mb-6">
                <div class="bg-surface px-4 py-2 border-b border-border-subtle">
                  <span class="text-sm text-secondary">shell — for an OpenAI-compatible endpoint</span>
                </div>
                <pre class="p-4 overflow-x-auto"><code class="text-sm text-primary">{`curl -X PUT https://api.humanjudge.com/api/v1/models/{model_id}/endpoint-config \\
  -H "Authorization: Bearer <your platform JWT>" \\
  -H "Content-Type: application/json" \\
  -d '{
    "endpoint": "https://your-app.com/v1/chat/completions",
    "apiKey": "sk-your-model-api-key",
    "request_template": "{\\"model\\":\\"gpt-4o\\",\\"messages\\":[{\\"role\\":\\"user\\",\\"content\\":\\"{{prompt}}\\"}]}",
    "response_path": "choices[0].message.content"
  }'`}</code></pre>
              </div>

              <div class="bg-surface-elevated border border-border-subtle rounded-lg overflow-hidden mb-6">
                <div class="bg-surface px-4 py-2 border-b border-border-subtle">
                  <span class="text-sm text-secondary">shell — for a custom endpoint returning {`{"answer": ...}`}</span>
                </div>
                <pre class="p-4 overflow-x-auto"><code class="text-sm text-primary">{`curl -X PUT https://api.humanjudge.com/api/v1/models/{model_id}/endpoint-config \\
  -H "Authorization: Bearer <your platform JWT>" \\
  -H "Content-Type: application/json" \\
  -d '{
    "endpoint": "https://your-app.com/generate",
    "apiKey": "your-internal-token",
    "request_template": "{\\"prompt\\":\\"{{prompt}}\\"}",
    "response_path": "answer"
  }'`}</code></pre>
              </div>

              <h3 class="text-lg font-semibold text-primary mb-3">2. Field reference</h3>
              <div class="bg-surface-elevated border border-border-subtle rounded-lg overflow-hidden mb-6">
                <table class="w-full text-sm">
                  <thead>
                    <tr class="bg-surface border-b border-border-subtle text-left text-secondary">
                      <th class="px-4 py-2">Field</th>
                      <th class="px-4 py-2">Description</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-border-subtle">
                    <tr>
                      <td class="px-4 py-2 text-primary align-top"><code class="text-xs">endpoint</code></td>
                      <td class="px-4 py-2 text-secondary">Full URL we POST to. Public URL required.</td>
                    </tr>
                    <tr>
                      <td class="px-4 py-2 text-primary align-top"><code class="text-xs">apiKey</code></td>
                      <td class="px-4 py-2 text-secondary">Sent as <code class="text-xs">Authorization: Bearer &lt;apiKey&gt;</code>. If your endpoint doesn't need auth, pass an empty string.</td>
                    </tr>
                    <tr>
                      <td class="px-4 py-2 text-primary align-top"><code class="text-xs">request_template</code></td>
                      <td class="px-4 py-2 text-secondary">A JSON string (as a string!) with <code class="text-xs">{`{{prompt}}`}</code> where the question goes. We substitute, then parse into a JSON body.</td>
                    </tr>
                    <tr>
                      <td class="px-4 py-2 text-primary align-top"><code class="text-xs">response_path</code></td>
                      <td class="px-4 py-2 text-secondary"><a href="https://jmespath.org" target="_blank" class="text-accent hover:underline">JMESPath</a> to the AI text in your JSON response. Examples: <code class="text-xs">"answer"</code>, <code class="text-xs">"choices[0].message.content"</code>, <code class="text-xs">"data.output"</code>.</td>
                    </tr>
                  </tbody>
                </table>
              </div>

              <h3 class="text-lg font-semibold text-primary mb-3">3. Test before enrolling</h3>
              <p class="text-secondary text-sm mb-3">
                The dashboard's <strong>Test endpoint</strong> button sends a sample prompt and shows what we extract. Or via API:
              </p>
              <div class="bg-surface-elevated border border-border-subtle rounded-lg overflow-hidden mb-6">
                <div class="bg-surface px-4 py-2 border-b border-border-subtle">
                  <span class="text-sm text-secondary">shell</span>
                </div>
                <pre class="p-4 overflow-x-auto"><code class="text-sm text-primary">{`curl -X POST https://api.humanjudge.com/api/v1/models/{model_id}/test-endpoint \\
  -H "Authorization: Bearer <your platform JWT>" \\
  -H "Content-Type: application/json" \\
  -d '{ ...same body as save... }'

# Returns { "success": true, "output": "<what we extracted>" }
# or     { "success": false, "error": "<what went wrong>" }`}</code></pre>
              </div>

              <h3 class="text-lg font-semibold text-primary mb-3">4. Enroll in a benchmark</h3>
              <p class="text-secondary text-sm">
                Pick one from <a href="https://humanjudge.com/reviewer-hub" class="text-accent hover:underline">humanjudge.com/reviewer-hub</a>. We POST each benchmark question to your endpoint — every response becomes a trace, and reviewers grade them.
              </p>
            </div>

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- TAB PANEL — NO-CODE                                          -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <div id="tab-nocode" class="tab-panel hidden" role="tabpanel">
              <p class="text-secondary mb-6">
                Best when your stack isn't Python or Node — you're building on a workflow tool like <strong>Zapier</strong>, <strong>n8n</strong>, <strong>Make</strong>, <strong>Retool</strong>, or shelling out from <strong>Go</strong> / <strong>Rust</strong> / <strong>Ruby</strong> / a bash script. One POST per LLM call, no dependencies.
              </p>

              <h3 class="text-lg font-semibold text-primary mb-3">Send a trace with a plain HTTP request</h3>
              <div class="bg-surface-elevated border border-border-subtle rounded-lg overflow-hidden mb-6">
                <div class="bg-surface px-4 py-2 border-b border-border-subtle">
                  <span class="text-sm text-secondary">HTTP</span>
                </div>
                <pre class="p-4 overflow-x-auto"><code class="text-sm text-primary">{`POST https://api.humanjudge.com/api/v1/traces/ingest
Authorization: Bearer gj_sk_live_...
