---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';

// Fetch public reports from API at build time / on request
const API_BASE_URL = import.meta.env.PUBLIC_API_URL || 'https://grandjury-server.onrender.com';

// Matches backend ReportSummary model from report_page.py
interface ReportSummary {
  project_id: string;
  title: string;
  description: string | null;
  total_evaluations: number;
  flag_count: number;
  flag_rate: number;
  last_evaluation_at: string | null;
  report_url: string;
  visibility: string;
}

let reports: ReportSummary[] = [];
let error: string | null = null;

try {
  const response = await fetch(`${API_BASE_URL}/api/v1/public-reports/?limit=50`);
  if (response.ok) {
    const data = await response.json();
    reports = data.reports || [];
  } else {
    error = 'Failed to load reports';
  }
} catch (e) {
  error = 'Network error loading reports';
  console.error('Error fetching public reports:', e);
}

// Flag rate colors (lower is better)
function getFlagRateColor(rate: number): string {
  if (rate <= 10) return 'text-success';
  if (rate <= 30) return 'text-warning';
  return 'text-error';
}

function getFlagRateBg(rate: number): string {
  if (rate <= 10) return 'bg-success/10 border-success/20';
  if (rate <= 30) return 'bg-warning/10 border-warning/20';
  return 'bg-error/10 border-error/20';
}

const datasetSchema = {
  "@context": "https://schema.org",
  "@type": "DataCatalog",
  "name": "HumanJudge Public AI Evaluation Reports",
  "url": "https://humanjudge.com/public-reports",
  "description": `${reports.length} public AI benchmark reports evaluated by verified human reviewers. Each report contains per-model pass rates, flag rates, quality scores, and individual reviewer votes. Models include GPT-5.2, Claude Opus 4.6, Gemini 3, Grok 4, and developer-submitted models.`,
  "publisher": {
    "@type": "Organization",
    "name": "HumanJudge",
    "url": "https://humanjudge.com"
  },
  "dataset": reports.slice(0, 10).map(r => ({
    "@type": "Dataset",
    "name": r.title,
    "description": r.description || `AI evaluation benchmark with ${r.total_evaluations} human reviews. Flag rate: ${r.flag_rate.toFixed(1)}%.`,
    "url": `https://humanjudge.com${r.report_url}`,
    "creator": { "@type": "Organization", "name": "HumanJudge" },
    "distribution": {
      "@type": "DataDownload",
      "encodingFormat": "application/json",
      "contentUrl": `https://grandjury-server.onrender.com/api/v1/benchmarks/${r.project_id}/leaderboard`
    },
    "measurementTechnique": "Human evaluation by verified reviewers",
    "variableMeasured": [
      { "@type": "PropertyValue", "name": "total_reviews", "value": r.total_evaluations },
      { "@type": "PropertyValue", "name": "flag_rate", "value": r.flag_rate, "unitCode": "P1" }
    ]
  }))
};
---

<BaseLayout
  title="Public AI Evaluation Reports | Human-Reviewed AI Benchmarks | HumanJudge"
  description={`${reports.length} public AI benchmark reports evaluated by verified human reviewers. Per-model pass rates, quality scores, and transparent leaderboards for GPT-5.2, Claude, Gemini, Grok, and more.`}
  currentPath="/public-reports"
  jsonLd={datasetSchema}
>
  <!-- Hero Section -->
  <section class="py-16 bg-surface-elevated border-b border-border-subtle">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <h1 class="text-4xl sm:text-5xl font-bold text-primary mb-4">
          Public AI Evaluation Reports
        </h1>
        <p class="text-xl text-secondary max-w-3xl mx-auto">
          Transparent quality assessments from verified AI reviewers.
          See how AI systems perform across different domains.
        </p>
      </div>
    </div>
  </section>

  <!-- Reports Grid -->
  <section class="py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      {error && (
        <div class="bg-error/10 border border-error/20 text-error rounded-lg p-4 mb-8 text-center">
          {error}
        </div>
      )}

      {reports.length === 0 && !error && (
        <div class="text-center py-16">
          <svg class="mx-auto h-16 w-16 text-tertiary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <h3 class="mt-4 text-xl font-medium text-primary">No public reports yet</h3>
          <p class="mt-2 text-secondary max-w-md mx-auto">
            Public evaluation reports will appear here once projects make their reports visible.
          </p>
          <a
            href="/for-developers"
            class="mt-6 inline-block bg-accent text-accent-on px-6 py-3 rounded-md hover:bg-accent-hover transition-micro ease-smooth font-medium"
          >
            Learn About Reports
          </a>
        </div>
      )}

      {reports.length > 0 && (
        <>
          <p class="text-secondary mb-6">
            Showing {reports.length} public reports
          </p>

          <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {reports.map((report) => (
              <a
                href={`/reports/${report.project_id}`}
                class="block bg-surface rounded-lg shadow-soft hover:shadow-elevated border border-border-subtle transition-all duration-micro ease-smooth overflow-hidden group"
              >
                <!-- Card Header -->
                <div class="p-6 pb-4">
                  <div class="flex justify-between items-start mb-3">
                    <h2 class="text-lg font-semibold text-primary line-clamp-2 group-hover:text-accent transition-colors">
                      {report.title}
                    </h2>
                    <span class={`text-xs px-2 py-1 rounded-full border ${getFlagRateBg(report.flag_rate)}`}>
                      <span class={getFlagRateColor(report.flag_rate)}>
                        {report.flag_rate.toFixed(1)}% flagged
                      </span>
                    </span>
                  </div>
                  {report.description && (
                    <p class="text-secondary text-sm line-clamp-2 mb-3">
                      {report.description}
                    </p>
                  )}
                </div>

                <!-- Metrics Section -->
                <div class="bg-surface-elevated px-6 py-4 border-t border-border-subtle">
                  <div class="grid grid-cols-3 gap-4 text-center">
                    <div>
                      <p class="text-2xl font-bold text-primary">
                        {report.total_evaluations}
                      </p>
                      <p class="text-xs text-tertiary">Reviews</p>
                    </div>
                    <div>
                      <p class="text-2xl font-bold text-error">
                        {report.flag_count}
                      </p>
                      <p class="text-xs text-tertiary">Flags</p>
                    </div>
                    <div>
                      <p class={`text-2xl font-bold ${getFlagRateColor(report.flag_rate)}`}>
                        {report.flag_rate.toFixed(1)}%
                      </p>
                      <p class="text-xs text-tertiary">Flag Rate</p>
                    </div>
                  </div>
                </div>

                <!-- Footer -->
                <div class="px-6 py-3 border-t border-border-subtle flex justify-between items-center">
                  {report.last_evaluation_at ? (
                    <p class="text-xs text-tertiary">
                      Last review {new Date(report.last_evaluation_at).toLocaleDateString()}
                    </p>
                  ) : (
                    <p class="text-xs text-tertiary">No reviews yet</p>
                  )}
                  <span class="text-accent text-sm font-medium group-hover:underline">
                    View Report →
                  </span>
                </div>
              </a>
            ))}
          </div>
        </>
      )}
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-16 bg-surface-elevated border-t border-border-subtle">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold text-primary mb-4">
        Want Your AI Evaluated?
      </h2>
      <p class="text-xl text-secondary mb-8 max-w-2xl mx-auto">
        Get transparent quality reports for your AI system from verified expert reviewers.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/for-developers"
          class="bg-accent text-accent-on px-8 py-3 rounded-md hover:bg-accent-hover transition-micro ease-smooth font-medium"
        >
          Learn More
        </a>
        <a
          href="/dashboard"
          class="border border-accent text-accent px-8 py-3 rounded-md hover:bg-accent/10 transition-micro ease-smooth font-medium"
        >
          Sign in
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
