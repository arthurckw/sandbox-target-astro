---
/**
 * AI Profile SSR page — Fuji design.
 * Server HTML for SEO. React island for modals + waitlist.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import AIProfileIsland from '../../components/AIProfileIsland';

const { slug } = Astro.params;
const API_BASE = 'https://grandjury-server.onrender.com';

let ai: any = null;
let flagClaims: any[] = [];
// PBI-040: also fetch the single most recent flagged-with-feedback claim
// to power the description's "Full review:" quote trio. Listing endpoint
// returns truncated feedback only, so we follow up with a single-claim
// fetch for full trace input + output.
let featuredFlag: any = null;
try {
  const [aiRes, claimsRes, featuredListRes] = await Promise.all([
    fetch(`${API_BASE}/api/v1/ai/${slug}?reviews_limit=0`),
    fetch(`${API_BASE}/api/v1/claims/?model_slug=${slug}&comments_only=true&limit=5&sort=recent`),
    fetch(`${API_BASE}/api/v1/claims/?model_slug=${slug}&verdict=flag&comments_only=true&limit=1&sort=recent`),
  ]);
  if (aiRes.ok) ai = await aiRes.json();
  if (claimsRes.ok) {
    const claimsData = await claimsRes.json();
    flagClaims = claimsData.claims || [];
  }
  if (featuredListRes.ok) {
    const list = await featuredListRes.json();
    const topSlug = list.claims?.[0]?.slug;
    if (topSlug) {
      const oneRes = await fetch(`${API_BASE}/api/v1/claims/${topSlug}`);
      if (oneRes.ok) featuredFlag = await oneRes.json();
    }
  }
} catch {}

if (!ai) return Astro.redirect('/pulse', 302);

const { model, stats, challenges_breakdown } = ai;

// PBI-039: minimum reviewer count before high-confidence signals
// (AggregateRating schema + Rule 2 title pattern) are emitted. Keep in sync
// with app/api/claims.py:MIN_REVIEWS_FOR_AGGREGATE_RATING.
// Tuning: bump to 15 only if Google isn't rendering stars after 4 weeks
// (decision C3).
const MIN_REVIEWS_FOR_AGGREGATE_RATING = 10;

const totalVotes = stats.total_votes || 0;
const passRate = Math.round(stats.pass_rate || 0);
const reviewerCount = stats.reviewer_count || 0;
// Decision C2: gate + title use unique reviewer count, not total votes —
// matches platform language and avoids over-claiming.
const enoughReviews = reviewerCount >= MIN_REVIEWS_FOR_AGGREGATE_RATING;
const arenaCount = (challenges_breakdown || []).length;

// PBI-040 v2 title: error-count framing with date authority.
// `Research: {N_users} real users found {N_errors} {Model} errors | {date}`
// Below-threshold pages keep PBI-039's "Awaiting Human Reviews" fallback
// unchanged (PBI-040 is explicit: do not apply v2 voice below threshold).
const flagCount = stats.flag_count || 0;
const today = new Date();
const monthNames = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const dateStr = `${monthNames[today.getMonth()]} ${today.getDate()}, ${today.getFullYear()}`;

// PBI-040.1: strip provider prefix (e.g., "Anthropic: ", "Google: ", "xAI: ")
// from the model display name in seo_title only. The colon prefix eats
// 9-11 chars before the actual model identifier, which caused the 60-char
// truncation logic below to chop the *informative* part (model version),
// leaving titles like "Anthropic:… errors". Google then rewrote the title
// itself, erasing the v2 work. Body display + JSON-LD keep the prefix.
const seoModelName = model.display_name.replace(/^[A-Za-z][A-Za-z0-9-]*:\s+/, '');

let title: string;
if (!enoughReviews) {
  title = `${seoModelName}: Awaiting Human Reviews | HumanJudge`;
} else {
  title = `Research: ${reviewerCount} real users found ${flagCount} ${seoModelName} errors | ${dateStr}`;
}
// 60-char SERP limit — when overflow happens, drop the date suffix first
// (least informational), then truncate the model name. Word-boundary safe.
if (title.length > 60 && enoughReviews) {
  // Try dropping the date suffix
  const withoutDate = `Research: ${reviewerCount} real users found ${flagCount} ${seoModelName} errors`;
  if (withoutDate.length <= 60) {
    title = withoutDate;
  } else {
    // Still too long — truncate model name
    const overflow = withoutDate.length - 60 + 1;
    const shortName = seoModelName.slice(0, seoModelName.length - overflow).replace(/\s+\S*$/, '') + '…';
    title = withoutDate.replace(seoModelName, shortName);
  }
}

// PBI-040 v2 description — "Learn from real AI users" lead, then the
// `Full review: AI output: '...' Input: '...' Reviewer: '...'` trio.
// Deliberately exceeds Google's ~155-char truncation so the cut lands
// mid-quote (curiosity-gap bait). DO NOT truncate in the renderer.
// Fall back to v1 description if no flagged claim is available for the trio.
function previewText(s: string | null | undefined, len: number): string {
  if (!s) return '';
  const stripped = String(s).replace(/\s+/g, ' ').trim();
  return stripped.length > len ? stripped.slice(0, len) : stripped;
}

let description: string;
if (!enoughReviews) {
  description = `${model.display_name} on HumanJudge — awaiting human reviewers to publish a confidence score. Independent evaluation, not LLM-as-judge.`;
} else if (featuredFlag && (featuredFlag.feedback?.length ?? 0) >= 60) {
  const out = previewText(featuredFlag.trace_output, 110);
  const inp = previewText(featuredFlag.trace_input, 80);
  const rev = previewText(featuredFlag.feedback, 110);
  description = `Learn from real AI users: ${reviewerCount} real users tested ${model.display_name} across ${arenaCount || 'multiple'} arena${arenaCount === 1 ? '' : 's'}. Datasets published on humanjudge.com, MCP, GPT Store, Python SDK. Full review: AI output: '${out}...' Input: '${inp}...' Reviewer: '${rev}...`;
} else {
  // No eligible flagged claim — fall back to v1 description for this page
  // until enough flagged feedback accumulates.
  description = `${reviewerCount} human reviewers across ${arenaCount || 'multiple'} benchmark${arenaCount === 1 ? '' : 's'}. ${passRate}% backed by humans. Independent evaluation — not LLM-as-judge.`;
}

// PBI-039 Rule 3: AggregateRating on 5-point scale, gated on MIN_REVIEW_COUNT.
// Below threshold the block is omitted entirely (NOT emitted with reviewCount: 0
// — Schema.org rejects that). 0–100 internal pass_rate is mapped to 0–5.
// SoftwareApplication rich-result spec requires AT LEAST 2 of:
// offers / aggregateRating / applicationCategory / operatingSystem.
// applicationCategory + operatingSystem guarantee 2 are always present —
// so the SoftwareApplication card stays valid even below the
// MIN_REVIEWS_FOR_AGGREGATE_RATING threshold where aggregateRating
// is omitted. "Web" is accurate (models are accessed via web/API).
const softwareAppNode: any = {
  '@type': 'SoftwareApplication',
  name: model.display_name,
  applicationCategory: 'Artificial Intelligence',
  operatingSystem: 'Web',
};
if (enoughReviews) {
  softwareAppNode.aggregateRating = {
    '@type': 'AggregateRating',
    ratingValue: Math.round((stats.pass_rate / 100) * 5 * 10) / 10,
    bestRating: 5,
    worstRating: 0,
    // Decision C2: surface unique reviewers, not total votes — matches
    // platform language and avoids over-claiming on traces with repeat voters.
    ratingCount: reviewerCount,
    reviewCount: reviewerCount,
  };
}

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'HumanJudge', item: 'https://humanjudge.com' },
        { '@type': 'ListItem', position: 2, name: 'Pulse', item: 'https://humanjudge.com/pulse' },
        { '@type': 'ListItem', position: 3, name: model.display_name },
      ],
    },
    softwareAppNode,
  ],
};

const btnPrimary = 'inline-flex items-center justify-center rounded-md bg-accent px-5 py-2.5 text-sm font-medium text-accent-on shadow-xs hover:bg-accent-hover';
const btn = 'inline-flex items-center justify-center rounded-md bg-surface border border-border-emphasis px-5 py-2.5 text-sm font-medium text-secondary shadow-xs hover:bg-surface-elevated hover:text-primary hover:border-border-bright';
---

<BaseLayout title={title} description={description} jsonLd={jsonLd} keywords={`${model.display_name}, AI evaluation, AI benchmark, human review`} hideChrome>

<div class="min-h-screen bg-bg text-primary font-sans">

  <!-- React Island: modals + waitlist -->
  <AIProfileIsland client:load modelSlug={slug} modelName={model.display_name} flagClaims={flagClaims} />

  <!-- Sticky header -->
  <div class="sticky top-0 z-40 bg-surface shadow-[0_4px_12px_rgba(0,0,0,0.3)]">
    <div class="pt-3 pb-3 flex justify-center">
      <a href="/pulse" class="flex items-center gap-1.5 text-xs text-tertiary uppercase tracking-[0.2em] font-mono hover:text-secondary transition-[color] duration-150">
        <span>HumanJudge</span>
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2" />
        </svg>
        <span>Pulse Check</span>
      </a>
    </div>
  </div>

  <div class="max-w-3xl mx-auto px-4 py-8">

    {!enoughReviews && (
      <!-- PBI-039 decision D: page-body banner explaining why no confidence
           score is published yet. Triggered by same threshold as the
           "Awaiting Human Reviews" title fallback so the two never disagree. -->
      <div class="mb-8 p-4 rounded-lg bg-surface border border-border-emphasis">
        <p class="text-sm text-secondary leading-relaxed">
          <strong class="text-primary">Awaiting human reviewers.</strong>
          {' '}This model has {reviewerCount} {reviewerCount === 1 ? 'reviewer' : 'reviewers'} so far — we publish a confidence score once at least {MIN_REVIEWS_FOR_AGGREGATE_RATING} verified humans have evaluated outputs. Until then, individual reviews below are still visible.{' '}
          <a href="/auth?role=reviewer" class="text-accent hover:text-accent-hover underline">Become a reviewer →</a>
        </p>
      </div>
    )}

    <!-- Header -->
    <div class="mb-10">
      <h1 class="text-3xl sm:text-4xl font-normal text-primary">{model.display_name}</h1>
      {model.is_oc_agent ? (
        <p class="text-tertiary text-sm mt-1">OpenClaw Agent</p>
      ) : model.provider && model.provider !== 'beast_mode' ? (
        <p class="text-tertiary text-sm mt-1">by <span class="text-secondary capitalize">{model.provider}</span></p>
      ) : null}
      {!model.is_oc_agent && model.domain_pattern && (
        <p class="text-tertiary text-sm mt-1 font-mono">{model.domain_pattern}</p>
      )}
      {model.description && (
        <p class="text-secondary text-sm mt-2 leading-relaxed">{model.description}</p>
      )}
      <p class="text-secondary text-base mt-4 font-mono">
        {stats.total_votes.toLocaleString()} claims submitted by {stats.reviewer_count} reviewers
      </p>
    </div>

    <!-- Monitoring status (Step A of badge rollout) — shown when the model has
         a tracking pipeline wired (traces flowing OR enrolled in a benchmark).
         Hides for never-wired models so the existing "Awaiting human review"
         flow for those isn't disturbed. -->
    {ai.monitoring && (ai.monitoring.trace_count > 0 || (ai.monitoring.enrolled_benchmarks?.length || 0) > 0) && (
      <div class="mb-10 bg-surface border border-border-emphasis p-5">
        <div class="flex flex-wrap items-center gap-x-3 gap-y-1 mb-2">
          <span class="inline-flex items-center gap-2">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full opacity-75" style="background-color: var(--color-success);"></span>
              <span class="relative inline-flex rounded-full h-2 w-2" style="background-color: var(--color-success);"></span>
            </span>
            <span class="text-primary text-sm font-semibold">Monitored by HumanJudge</span>
          </span>
          <span class="text-tertiary">·</span>
          <span class="text-secondary text-sm">
            Endpoint registered, <span class="text-primary font-medium">{ai.monitoring.trace_count.toLocaleString()}</span> trace{ai.monitoring.trace_count !== 1 ? 's' : ''} logged
          </span>
        </div>

        {ai.monitoring.owner && (ai.monitoring.owner.org_name || ai.monitoring.owner.display_name) && (
          <div class="text-secondary text-sm">
            Maintained by{' '}
            {ai.monitoring.owner.org_name ? (
              ai.monitoring.owner.org_slug ? (
                <a href={`/o/${ai.monitoring.owner.org_slug}`} class="text-accent hover:underline font-medium">{ai.monitoring.owner.org_name}</a>
              ) : (
                <span class="text-primary font-medium">{ai.monitoring.owner.org_name}</span>
              )
            ) : (
              <span class="text-primary font-medium">{ai.monitoring.owner.display_name}</span>
            )}
            {ai.monitoring.owner.org_name && ai.monitoring.owner.display_name && (
              <span class="text-tertiary"> · {ai.monitoring.owner.display_name}</span>
            )}
          </div>
        )}

        {ai.monitoring.enrolled_benchmarks?.length > 0 && (
          <div class="text-secondary text-sm mt-1">
            Enrolled in: {ai.monitoring.enrolled_benchmarks.map((b: any, i: number) => (
              <span>
                {i > 0 && <span class="text-tertiary">, </span>}
                <span class="text-primary">{b.title}</span>
              </span>
            ))}
          </div>
        )}
      </div>
    )}

    <!-- Performance -->
    {challenges_breakdown.length > 0 && (
      <div class="mb-10">
        <div class="text-[10px] text-tertiary uppercase tracking-widest font-mono mb-4">Performance</div>
        <div class="space-y-3">
          {challenges_breakdown.map((cb: any) => (
            <div class="px-4 py-3 bg-surface border border-border-emphasis">
              <div class="flex items-center justify-between">
                <span class="text-primary text-sm font-medium">{cb.challenge_title}</span>
                <span class="text-secondary text-sm font-mono">{cb.pass_rate.toFixed(0)}%</span>
              </div>
              <div class="flex items-center gap-3 mt-1">
                <span class="text-tertiary text-xs">{cb.total_votes} votes</span>
                <span class="text-tertiary text-xs">{cb.flag_count} flags</span>
                <span class="text-tertiary text-xs">{cb.reviewer_count} reviewers</span>
              </div>
              <div class="w-full h-1.5 bg-bg mt-2 flex">
                <div class="h-full bg-info" style={`width: ${cb.pass_rate}%`}></div>
                <div class="h-full bg-danger" style={`width: ${100 - cb.pass_rate}%`}></div>
              </div>
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- VERIFIED PARTNER -->
    {!model.is_oc_agent && model.is_verified_partner && (
      <div class="mb-10">
        {/* HEX-COLOR EXEMPTION: the star badge SVGs below mirror the
            published verified-badge product spec (customer-facing brand
            artifacts). Design tokens don't apply here on purpose. */}
        <!-- General partner badge -->
        <div class="flex mb-4">
          <div class="border-2 border-success bg-success-soft px-5 py-3 flex items-center gap-3 shadow-lg">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
              <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z" fill="#ecfdf5" stroke="#10b981" stroke-width="1.5"/>
              <circle cx="12" cy="12" r="3" fill="#064e3b"/>
            </svg>
            <div>
              <div class="text-success text-sm font-bold">Verified by HumanJudge</div>
              <div class="text-success text-[10px]">Independent Human Evaluation Partner</div>
            </div>
          </div>
        </div>

        <!-- Per-arena performance badges -->
        <div class="flex flex-wrap gap-3 mb-6">
          {challenges_breakdown.map((cb: any) => {
            const isPerformance = cb.total_votes >= 5 && cb.reviewer_count >= 3;
            const isBase = cb.total_votes >= 1;
            if (!isBase) return null;
            return isPerformance ? (
              <div class="border-2 border-success bg-success-soft px-4 py-3 flex items-center gap-3 shadow-lg">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                  <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z" fill="#ecfdf5" stroke="#10b981" stroke-width="1.5"/>
                  <circle cx="12" cy="12" r="3" fill="#064e3b"/>
                </svg>
                <div>
                  <div class="text-success text-[11px]">HumanJudge Verified</div>
                  <div class="text-success text-lg font-bold">{cb.pass_rate.toFixed(0)}% Positive</div>
                  <div class="text-success text-[9px]">{cb.reviewer_count} evaluators</div>
                </div>
              </div>
            ) : (
              <div class="border-2 border-border-emphasis bg-surface-elevated px-4 py-3 flex items-center gap-3 shadow-lg">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                  <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z" fill="#f9fafb" stroke="#9ca3af" stroke-width="1"/>
                  <circle cx="12" cy="12" r="3" fill="#1f2937"/>
                </svg>
                <div>
                  <div class="text-primary text-[11px] font-semibold">Monitored by HumanJudge</div>
                  <div class="text-secondary text-[9px]">{cb.total_votes} evaluations</div>
                </div>
              </div>
            );
          })}
        </div>

        <p class="text-secondary text-sm leading-relaxed">
          {model.display_name} participates in HumanJudge's independent, double-blind human evaluation program. Its outputs are systematically reviewed by verified human evaluators who do not know which AI produced each response.
        </p>
      </div>
    )}

    <!-- UNVERIFIED (Public AIs without partner status, AND not actively monitored).
         Hidden once the AI is monitored — the "Monitored by HumanJudge" banner
         above already credits the active tracking pipeline, so this scary
         "no evaluation, no audit" copy would directly contradict it. -->
    {!model.is_oc_agent && !model.is_verified_partner && !(ai.monitoring && (ai.monitoring.trace_count > 0 || (ai.monitoring.enrolled_benchmarks?.length || 0) > 0)) && (
      <div class="mb-10 border border-danger/20 bg-danger/5 p-6">
        <div class="border-2 border-white mb-6 max-w-xs mx-auto">
          <div class="bg-black py-2 text-center">
            <span class="text-white text-xs font-bold uppercase tracking-[0.35em]">Transparency</span>
          </div>
          <div class="bg-white py-2 text-center">
            <span class="text-black text-3xl font-black uppercase tracking-[0.05em] leading-none" style="font-stretch: condensed;">Unverified</span>
          </div>
          <div class="bg-black py-2 text-center">
            <span class="text-white text-[10px] font-bold uppercase tracking-[0.3em]">No Independent Human Evaluation</span>
          </div>
        </div>

        <p class="text-secondary text-sm leading-relaxed mb-3">
          {model.display_name} has no publicly available, independent human evaluation process. No open record. No third-party audit. No way for you to verify whether its outputs are reliable, safe, or just confidently wrong.
        </p>

        <p class="text-secondary text-sm leading-relaxed mb-3">
          This is the norm — and it's a problem. <a href="https://hrtechcube.com/survey-only-17-trust-ai-without-oversight/" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">Only 17% of people trust AI without oversight</a>. <a href="https://www.technologyreview.com/2026/03/31/1134833/ai-benchmarks-are-broken-heres-what-we-need-instead/" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">AI benchmarks are broken</a> — companies grade their own homework, then market the results. The gap between what AI companies claim and what consumers actually trust is <a href="https://www.globenewswire.com/news-release/2026/03/26/3263144/0/en/THE-AI-PERCEPTION-GAP-STUDY-REVEALS-40-POINT-GAP-BETWEEN-MARKETER-OPTIMISM-AND-CONSUMER-TRUST" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">40 points wide</a>. Regulators worldwide — from the <a href="https://www.legalnodes.com/article/eu-ai-act-2026-updates-compliance-requirements-and-business-risks" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">EU AI Act</a> to <a href="https://www.nist.gov/news-events/news/2026/01/towards-best-practices-automated-benchmark-evaluations" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">NIST standards</a> — are moving toward mandatory independent evaluation. The industry isn't ready.
        </p>

        <p class="text-secondary text-sm leading-relaxed mb-3">
          If you're relying on this AI, you're trusting a black box. No independent audit. No public evaluation record. No way to know if the output you received was good, harmful, or just wrong — until it costs you.
        </p>

        <p class="text-primary text-sm font-medium leading-relaxed">
          Below are independent claims from HumanJudge's double-blind evaluation — verified human reviewers judged this AI's real outputs without knowing which AI produced them.
        </p>
      </div>
    )}

    <!-- Latest Claims -->
    <div class="mb-10">
      <div class="text-[10px] text-tertiary uppercase tracking-widest font-mono mb-4">Independent Claims</div>
      {flagClaims.length > 0 ? (
        <div class="space-y-2" id="ai-flag-claims">
          {flagClaims.map((c: any, i: number) => {
            const isBlurred = i > 0;
            return isBlurred ? (
              <div
                class="px-4 py-3 bg-surface border border-border-emphasis select-none cursor-pointer"
                style="filter: blur(3px)"
                onclick="window.__aiProfile?.subscribe('ai_profile_blurred_claim')"
              >
                <div class="flex items-center gap-2 mb-1">
                  <span class={`text-[9px] px-1 py-0.5 rounded-sm font-medium ${c.verdict === 'flag' ? 'bg-danger/15 text-danger' : 'bg-success/15 text-success'}`}>{c.verdict}</span>
                  <span class="text-secondary text-xs">{c.benchmark_name}</span>
                  <span class="text-tertiary text-[10px] ml-auto font-mono">{new Date(c.created_at).toLocaleDateString()}</span>
                </div>
                <p class="text-primary/70 text-sm leading-relaxed line-clamp-2">{c.feedback}</p>
                <p class="text-tertiary text-xs mt-1">— {c.reviewer_name}</p>
              </div>
            ) : (
              <a href={`/claims/${c.slug}`} class="block px-4 py-3 bg-surface border border-border-emphasis hover:bg-surface-elevated transition-[background-color] duration-150">
                <div class="flex items-center gap-2 mb-1">
                  <span class={`text-[9px] px-1 py-0.5 rounded-sm font-medium ${c.verdict === 'flag' ? 'bg-danger/15 text-danger' : 'bg-success/15 text-success'}`}>{c.verdict}</span>
                  <span class="text-secondary text-xs">{c.benchmark_name}</span>
                  <span class="text-tertiary text-[10px] ml-auto font-mono">{new Date(c.created_at).toLocaleDateString()}</span>
                </div>
                <p class="text-primary text-sm leading-relaxed line-clamp-2">{c.feedback}</p>
                <p class="text-tertiary text-xs mt-1">— {c.reviewer_name}</p>
              </a>
            );
          })}
        </div>
      ) : (
        <p class="text-tertiary text-sm">No claims with reviewer comments yet.</p>
      )}
    </div>

    <!-- Independence Statement -->
    <div class="mb-10 border-t border-border-emphasis pt-8">
      <p class="text-secondary text-sm leading-relaxed">
        This evaluation was conducted independently. {model.display_name} did not participate
        in or pay for this evaluation. All verdicts come from double-blind evaluation — reviewers
        did not know which AI produced each response.
      </p>
    </div>

    <!-- Is this your product? — hide for OpenClaw agents AND for already-claimed
         models (the new monitoring block above already credits the maintainer). -->
    {!model.is_oc_agent && !ai.monitoring?.owner && (
      <div class="mb-10 bg-surface border border-border-emphasis p-6">
        <p class="text-primary text-sm font-medium mb-2">Is this your product?</p>
        <p class="text-tertiary text-xs mb-4">Claim your AI's profile, access evaluation data, and get verified.</p>
        <div class="space-y-3" id="ai-owner-form">
          <input type="email" placeholder="your@company.com" id="ai-owner-email" class="w-full rounded-md border border-border-emphasis bg-bg px-4 py-3 text-sm text-primary placeholder:text-tertiary focus:outline-none focus:border-accent" />
          <button onclick="window.__aiProfile?.claimOwner()" class={`w-full ${btnPrimary}`}>Get in Touch</button>
        </div>
        <div id="ai-owner-done" class="hidden">
          <p class="text-success text-sm text-center py-3">We'll be in touch!</p>
        </div>
      </div>
    )}

    <!-- Support This Mission -->
    <div class="mb-10">
      <p class="text-secondary text-sm leading-relaxed">We help people define what trustworthy AI looks like — publicly, transparently, together. <a href="/about" onclick="window.gtag?.('event','cta_click',{event_category:'ai_profile',cta:'invest',position:'ai_profile_support_mission'})" class="text-accent hover:underline">Support this mission</a></p>
    </div>

  </div>
</div>

</BaseLayout>
