---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTA from '../../components/CTA.astro';
import FAQ from '../../components/FAQ.astro';
---

<BaseLayout
  title="AI Empowerment Program | Get Paid to Evaluate AI | HumanJudge"
  description="Join the AI Empowerment Program. Evaluate AI in topics you know. Build a public expert profile. Get gift cards and early access to monetization."
  currentPath="/programs/ai-empowerment"
>
  <link slot="head" rel="canonical" href="https://humanjudge.com/programs/ai-empowerment" />

  <!-- FAQ Schema for SEO -->
  <script type="application/ld+json" slot="head">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Do I need credentials or tests to join?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "No gatekeeping. No tests. No interviews. If you know a topic, you can start reviewing immediately."
        }
      },
      {
        "@type": "Question",
        "name": "Is this paid work?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. Top contributors get Amazon gift cards. Early contributors also get first access to monetize when AI developers join the platform."
        }
      },
      {
        "@type": "Question",
        "name": "What makes this different from AI trainer platforms?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Your name goes on your work. You pick topics you care about. No random task assignments. You build a public profile, not anonymous cheap labor."
        }
      }
    ]
  }
  </script>

  <!-- Hero: Mother WHO PAS -->
  <section class="py-16 sm:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <!-- Left: Text Content -->
        <div class="text-center lg:text-left">
          <div class="inline-flex items-center px-3 py-1 rounded-full bg-accent/10 text-accent text-sm font-medium mb-4">
            AI Empowerment Program
          </div>
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-primary leading-tight mb-6">
            Judge AI in Topics You Know.<br/>
            <span class="text-accent">Build a Public Expert Profile.</span>
          </h1>
          <p class="text-xl text-secondary max-w-xl mx-auto lg:mx-0 mb-4">
            Every time AI gets something wrong in your area, you notice — but noticing doesn't get you anything.
          </p>
          <p class="text-lg text-secondary max-w-xl mx-auto lg:mx-0 mb-8">
            The alternative? Grind through gatekeeping tests at some AI trainer platform, then get assigned random tasks.
          </p>
          <p class="text-lg text-primary font-medium max-w-xl mx-auto lg:mx-0 mb-8">
            Join challenges you care about instead. Judge AI through chat and votes. Build your public expert profile — with your name on it.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
            <a
              href="/empowerment"
              class="bg-accent text-accent-on px-8 py-4 rounded-md hover:bg-accent-hover transition-micro ease-smooth font-medium text-lg inline-block text-center"
            >
              Apply to Join
            </a>
            <a
              href="/ai-reviews"
              class="border border-accent text-accent px-8 py-4 rounded-md hover:bg-accent/10 transition-micro ease-smooth font-medium text-lg inline-block text-center"
            >
              Browse Topics →
            </a>
          </div>
        </div>

        <!-- Right: Visual Element -->
        <div class="order-first lg:order-last">
          <div class="bg-surface-elevated border border-border-subtle rounded-2xl p-8 max-w-md mx-auto">
            <div class="space-y-4">
              <!-- Simulated profile card -->
              <div class="bg-surface border border-accent/30 rounded-lg p-4">
                <div class="flex items-start gap-3">
                  <div class="w-12 h-12 bg-accent/20 rounded-full flex items-center justify-center text-xl">JK</div>
                  <div class="flex-1">
                    <p class="text-primary font-semibold">Jin Kim</p>
                    <p class="text-sm text-secondary mb-2">K-Pop Expert · 47 reviews</p>
                    <div class="flex items-center gap-2">
                      <span class="bg-accent/20 text-accent text-xs px-2 py-0.5 rounded">Top Contributor</span>
                      <span class="text-xs text-secondary">Public Profile</span>
                    </div>
                  </div>
                </div>
              </div>
              <!-- Verdict preview -->
              <div class="bg-surface border border-border-subtle rounded-lg p-4 opacity-80">
                <p class="text-sm text-secondary mb-1">Latest verdict:</p>
                <p class="text-primary text-sm">"AI confused NewJeans debut date with LE SSERAFIM's. Basic error."</p>
                <div class="flex items-center gap-2 mt-2">
                  <span class="bg-danger/20 text-danger text-xs px-2 py-0.5 rounded">Fail</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Who This Is For - Persona Tabs -->
  <section class="py-16 bg-surface-elevated border-y border-border-subtle">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-bold text-primary text-center mb-4">
        Who This Is For
      </h2>
      <p class="text-secondary text-center mb-12 max-w-2xl mx-auto">
        Same program, different needs. Find what matters to you.
      </p>

      <div class="grid md:grid-cols-3 gap-8">
        <!-- For Students -->
        <div class="bg-surface border border-border-subtle rounded-xl p-8 hover:border-accent/50 transition-colors">
          <div class="w-14 h-14 bg-accent/10 rounded-xl flex items-center justify-center text-3xl mb-6">
            🎓
          </div>
          <h3 class="text-xl font-semibold text-primary mb-3">For Students</h3>
          <p class="text-secondary mb-4">
            You want to get into AI, but every path is about contributing to someone else's project — not building anything for yourself.
          </p>
          <p class="text-secondary mb-4 text-sm">
            Research roles? Your work gets open-sourced or never used. AI trainer gigs barely add to your CV.
          </p>
          <div class="border-t border-border-subtle pt-4 mt-4">
            <p class="text-primary font-medium mb-2">What you get:</p>
            <ul class="space-y-2 text-sm text-secondary">
              <li class="flex items-start gap-2">
                <span class="text-accent">→</span>
                Something real for your CV
              </li>
              <li class="flex items-start gap-2">
                <span class="text-accent">→</span>
                Public profile with your name
              </li>
              <li class="flex items-start gap-2">
                <span class="text-accent">→</span>
                Pick topics you care about
              </li>
            </ul>
          </div>
        </div>

        <!-- For Gig Seekers -->
        <div class="bg-surface border border-border-subtle rounded-xl p-8 hover:border-accent/50 transition-colors">
          <div class="w-14 h-14 bg-accent/10 rounded-xl flex items-center justify-center text-3xl mb-6">
            💰
          </div>
          <h3 class="text-xl font-semibold text-primary mb-3">For Gig Seekers</h3>
          <p class="text-secondary mb-4">
            You've seen AI trainer jobs. You think you could do it. But they're either impossible to get into, or they pay pennies for random labels.
          </p>
          <p class="text-secondary mb-4 text-sm">
            Pass their tests, and you end up labeling random data. No ownership, just cheap labor.
          </p>
          <div class="border-t border-border-subtle pt-4 mt-4">
            <p class="text-primary font-medium mb-2">What you get:</p>
            <ul class="space-y-2 text-sm text-secondary">
              <li class="flex items-start gap-2">
                <span class="text-accent">→</span>
                Skip the gatekeeping
              </li>
              <li class="flex items-start gap-2">
                <span class="text-accent">→</span>
                Gift cards for top contributors
              </li>
              <li class="flex items-start gap-2">
                <span class="text-accent">→</span>
                First access to monetize later
              </li>
            </ul>
          </div>
        </div>

        <!-- For Career Builders -->
        <div class="bg-surface border border-border-subtle rounded-xl p-8 hover:border-accent/50 transition-colors">
          <div class="w-14 h-14 bg-accent/10 rounded-xl flex items-center justify-center text-3xl mb-6">
            📈
          </div>
          <h3 class="text-xl font-semibold text-primary mb-3">For Career Builders</h3>
          <p class="text-secondary mb-4">
            You have domain expertise. You see AI coming. The paths you find — AI trainer jobs — treat your knowledge as cheap labor.
          </p>
          <p class="text-secondary mb-4 text-sm">
            Grind through their tests, and you end up labeling random data. Your expertise doesn't matter.
          </p>
          <div class="border-t border-border-subtle pt-4 mt-4">
            <p class="text-primary font-medium mb-2">What you get:</p>
            <ul class="space-y-2 text-sm text-secondary">
              <li class="flex items-start gap-2">
                <span class="text-accent">→</span>
                Build visible expertise
              </li>
              <li class="flex items-start gap-2">
                <span class="text-accent">→</span>
                Your name, protected
              </li>
              <li class="flex items-start gap-2">
                <span class="text-accent">→</span>
                Monetization pathway
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- How It Works Section -->
  <section id="how-it-works" class="py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-bold text-primary text-center mb-4">
        How It Works
      </h2>
      <p class="text-secondary text-center mb-12 max-w-2xl mx-auto">
        Join challenges you pick. Chat with AI. Vote pass or fail. Every judgment builds your public profile.
      </p>

      <div class="relative">
        <!-- Connecting line (hidden on mobile) -->
        <div class="hidden md:block absolute top-8 left-[16.67%] right-[16.67%] h-0.5 bg-gradient-to-r from-accent/20 via-accent to-accent/20 z-0"></div>

        <div class="grid md:grid-cols-3 gap-8">
          <!-- Step 1 -->
          <div class="relative text-center">
            <div class="w-16 h-16 bg-surface border-2 border-accent rounded-full flex items-center justify-center mx-auto mb-6 relative z-10">
              <span class="text-2xl font-bold text-accent">1</span>
            </div>
            <h3 class="text-xl font-semibold text-primary mb-3">Pick Topics You Know</h3>
            <p class="text-secondary">
              We run challenges in different domains. You pick what matches your expertise — K-pop, languages, culture, whatever you know.
            </p>
          </div>

          <!-- Step 2 -->
          <div class="relative text-center">
            <div class="w-16 h-16 bg-surface border-2 border-accent rounded-full flex items-center justify-center mx-auto mb-6 relative z-10">
              <span class="text-2xl font-bold text-accent">2</span>
            </div>
            <h3 class="text-xl font-semibold text-primary mb-3">Chat & Judge</h3>
            <p class="text-secondary">
              Use our playground to chat with AI on your topic. Test it. Then vote: pass or fail. Add your reasoning.
            </p>
          </div>

          <!-- Step 3 -->
          <div class="relative text-center">
            <div class="w-16 h-16 bg-surface border-2 border-accent rounded-full flex items-center justify-center mx-auto mb-6 relative z-10">
              <span class="text-2xl font-bold text-accent">3</span>
            </div>
            <h3 class="text-xl font-semibold text-primary mb-3">Build Your Profile</h3>
            <p class="text-secondary">
              Your name. Your judgments. Your reasoning. All public. Every review builds your expert profile.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Rewards Section -->
  <section class="py-20 bg-surface-elevated">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-bold text-primary text-center mb-4">
        What You Get
      </h2>
      <p class="text-secondary text-center mb-12 max-w-2xl mx-auto">
        Real rewards now. Bigger opportunity later.
      </p>

      <div class="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto">
        <!-- Now -->
        <div class="bg-surface border border-accent/30 rounded-xl p-8">
          <div class="inline-flex items-center px-3 py-1 rounded-full bg-accent/10 text-accent text-sm font-medium mb-4">
            Now
          </div>
          <h3 class="text-2xl font-semibold text-primary mb-4">Gift Cards for Top Contributors</h3>
          <ul class="space-y-3">
            <li class="flex items-start gap-3 text-secondary">
              <span class="text-accent text-lg">→</span>
              Amazon gift cards for active reviewers
            </li>
            <li class="flex items-start gap-3 text-secondary">
              <span class="text-accent text-lg">→</span>
              Public expert profile with your name
            </li>
            <li class="flex items-start gap-3 text-secondary">
              <span class="text-accent text-lg">→</span>
              No gatekeeping — start immediately
            </li>
            <li class="flex items-start gap-3 text-secondary">
              <span class="text-accent text-lg">→</span>
              Pick domains you're actually interested in
            </li>
          </ul>
        </div>

        <!-- Future -->
        <div class="bg-surface border border-border-subtle rounded-xl p-8">
          <div class="inline-flex items-center px-3 py-1 rounded-full bg-surface-elevated text-secondary text-sm font-medium mb-4">
            Future
          </div>
          <h3 class="text-2xl font-semibold text-primary mb-4">First Access to Monetize</h3>
          <ul class="space-y-3">
            <li class="flex items-start gap-3 text-secondary">
              <span class="text-secondary text-lg">→</span>
              When AI developers join, early contributors monetize first
            </li>
            <li class="flex items-start gap-3 text-secondary">
              <span class="text-secondary text-lg">→</span>
              Earn per review
            </li>
            <li class="flex items-start gap-3 text-secondary">
              <span class="text-secondary text-lg">→</span>
              Exclusive expert views for AI developers
            </li>
            <li class="flex items-start gap-3 text-secondary">
              <span class="text-secondary text-lg">→</span>
              Your reviews compound in value
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Why We're Different -->
  <section class="py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-bold text-primary text-center mb-4">
        Not Another AI Trainer Platform
      </h2>
      <p class="text-xl text-secondary text-center max-w-3xl mx-auto mb-12">
        The difference is who gets credit.
      </p>

      <div class="grid md:grid-cols-2 gap-6 max-w-3xl mx-auto">
        <!-- HumanJudge Column -->
        <div class="bg-surface border border-accent/30 rounded-lg p-6">
          <h3 class="text-lg font-semibold text-accent mb-4 flex items-center gap-2">
            <span class="text-xl">✓</span> HumanJudge
          </h3>
          <ul class="space-y-3">
            <li class="flex items-start gap-2 text-primary">
              <span class="text-accent mt-0.5">•</span>
              No gatekeeping — join and start immediately
            </li>
            <li class="flex items-start gap-2 text-primary">
              <span class="text-accent mt-0.5">•</span>
              Domain-flexible — pick what you know
            </li>
            <li class="flex items-start gap-2 text-primary">
              <span class="text-accent mt-0.5">•</span>
              Your name on your judgments
            </li>
            <li class="flex items-start gap-2 text-primary">
              <span class="text-accent mt-0.5">•</span>
              Real rewards — gift cards, not exposure
            </li>
            <li class="flex items-start gap-2 text-primary">
              <span class="text-accent mt-0.5">•</span>
              Compounding value — early access to monetize
            </li>
          </ul>
        </div>

        <!-- AI Trainer Platforms Column -->
        <div class="bg-surface border border-border-subtle rounded-lg p-6">
          <h3 class="text-lg font-semibold text-secondary mb-4 flex items-center gap-2">
            <span class="text-xl">✗</span> AI Trainer Platforms
          </h3>
          <ul class="space-y-3">
            <li class="flex items-start gap-2 text-secondary">
              <span class="mt-0.5">•</span>
              Gatekeeping tests and interviews
            </li>
            <li class="flex items-start gap-2 text-secondary">
              <span class="mt-0.5">•</span>
              Assigned random tasks
            </li>
            <li class="flex items-start gap-2 text-secondary">
              <span class="mt-0.5">•</span>
              Anonymous work — no credit
            </li>
            <li class="flex items-start gap-2 text-secondary">
              <span class="mt-0.5">•</span>
              Pennies for random labels
            </li>
            <li class="flex items-start gap-2 text-secondary">
              <span class="mt-0.5">•</span>
              Nothing to show for it
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <FAQ
    title="Common Questions"
    items={[
      {
        question: "Do I need credentials or tests to join?",
        answer: "No gatekeeping. No tests. No interviews. If you know a topic, you can start reviewing immediately."
      },
      {
        question: "Is this paid work?",
        answer: "Yes. Top contributors get Amazon gift cards. Early contributors also get first access to monetize when AI developers join the platform."
      },
      {
        question: "What makes this different from AI trainer platforms?",
        answer: "Your name goes on your work. You pick topics you care about. No random task assignments. You build a public profile, not anonymous cheap labor."
      },
      {
        question: "How much can I earn?",
        answer: "Top contributors earn Amazon gift cards during campaigns. As the platform grows, early contributors get first access to per-review payments."
      },
      {
        question: "What topics are available?",
        answer: "40+ challenges across culture (K-pop, J-pop, anime), languages (Korean, Japanese, Spanish, Arabic), entertainment (cinema, drama), and academics (AP courses). More added regularly."
      }
    ]}
  />

  <!-- CTA -->
  <CTA
    title="Ready to Join?"
    description="Apply to the AI Empowerment Program. Pick topics you know. Start building your public expert profile."
    primaryButton={{ text: "Apply Now", href: "/empowerment" }}
    secondaryButton={{ text: "Browse Topics", href: "/ai-reviews" }}
    variant="accent"
  />
</BaseLayout>
