---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import FAQ from '../../components/FAQ.astro';
import CTA from '../../components/CTA.astro';
---

<BaseLayout
  title="Judge GPT's Christmas Advice | HumanJudge"
  description="People are trusting AI for Christmas advice. Help others see what actually works — and what doesn't."
  currentPath="/ai-reviews/christmas-2025"
>

  <style>
    /* Bobbing animation for topic cards */
    .topic-card {
      animation: bob 3s ease-in-out infinite;
    }

    .topic-card:nth-child(1) { animation-delay: 0s; }
    .topic-card:nth-child(2) { animation-delay: 0.5s; }
    .topic-card:nth-child(3) { animation-delay: 1s; }
    .topic-card:nth-child(4) { animation-delay: 1.5s; }
    .topic-card:nth-child(5) { animation-delay: 2s; }
    .topic-card:nth-child(6) { animation-delay: 2.5s; }

    @keyframes bob {
      0%, 100% {
        transform: translateY(0);
      }
      50% {
        transform: translateY(-8px);
      }
    }

    /* Snowfall in Hero */
    .hero-snowfall {
      position: relative;
    }

    .snowfall-container {
      position: absolute;
      inset: 0;
      overflow: hidden;
      pointer-events: none;
      z-index: 5;
    }

    .snowflake {
      position: absolute;
      top: -20px;
      color: rgba(255, 255, 255, 0.7);
      text-shadow: 0 0 3px rgba(255, 255, 255, 0.3);
      animation: snowfall linear infinite;
      will-change: transform;
    }

    @keyframes snowfall {
      0% {
        transform: translateY(0) rotate(0deg);
        opacity: 1;
      }
      100% {
        transform: translateY(100vh) rotate(360deg);
        opacity: 0.3;
      }
    }

    /* Reduce motion for accessibility */
    @media (prefers-reduced-motion: reduce) {
      .topic-card,
      .snowflake {
        animation: none;
      }
      .snowflake {
        display: none;
      }
    }
  </style>

  <!-- 1. Hero: Names the moment + gives the reader a role -->
  <div class="hero-snowfall">
    <div class="snowfall-container" id="hero-snowfall"></div>
    <Hero
    headline="GPT-5.2 just dropped.<br/>Does it actually know how to plan Christmas?"
    subheadline="You know what 'helpful' looks like. Be the judge—and show the world."
    description="Takes 5-10 minutes. No prep needed."
    primaryCTA={{ text: "Join the Check", href: "/auth" }}
    secondaryCTA={{ text: "See What You'll Do ↓", href: "#how-it-works" }}
  />
  </div>

  <!-- 2. Funny AI Fails: Relatable examples anyone would catch -->
  <section class="py-20 border-t border-border-subtle">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-bold text-center text-primary mb-4" data-aos="fade-up">
        Real AI Advice We've Seen
      </h2>

      <p class="text-xl text-secondary text-center mb-12" data-aos="fade-up" data-aos-delay="50">
        Just last month, <a href="https://fortune.com/2025/11/26/ai-slop-recipes-thanksgiving-food-blog-collapse-traffic/" target="_blank" rel="noopener noreferrer" class="text-accent hover:text-accent/80">Fortune reported</a> AI "slop recipes" are flooding cooking sites:
      </p>

      <div class="space-y-4" data-aos="fade-up" data-aos-delay="100">
        <div class="bg-surface-elevated border border-border-subtle rounded-lg p-5 flex items-start gap-4">
          <span class="text-2xl">🎂</span>
          <p class="text-lg text-primary">Christmas cake: <span class="text-accent font-medium">"Cook for 3-4 hours"</span> → charcoal</p>
        </div>

        <div class="bg-surface-elevated border border-border-subtle rounded-lg p-5 flex items-start gap-4">
          <span class="text-2xl">🫔</span>
          <p class="text-lg text-primary">Tamales: AI showed sauce poured over husks <span class="text-secondary">(you don't eat those)</span></p>
        </div>

        <div class="bg-surface-elevated border border-border-subtle rounded-lg p-5 flex items-start gap-4">
          <span class="text-2xl">🍪</span>
          <p class="text-lg text-primary">Cherry cookies: <span class="text-accent font-medium">"A melted sheet of dough. A disaster."</span></p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. How It Works + Task Preview -->
  <section id="how-it-works" class="py-20 bg-surface-elevated">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-bold text-center text-primary mb-4" data-aos="fade-up">
        Here's What You'll Do
      </h2>
      <p class="text-xl text-secondary text-center mb-12" data-aos="fade-up" data-aos-delay="50">
        5-10 minutes. No prep. Just react.
      </p>

      <!-- Task Preview Mock -->
      <div class="bg-surface border-2 border-accent/30 rounded-xl p-6 mb-12" data-aos="fade-up" data-aos-delay="100">
        <p class="text-sm text-secondary mb-3">Example prompt:</p>
        <p class="text-lg text-primary font-medium mb-4">"Plan Christmas dinner for 6 people, $50 budget"</p>

        <div class="bg-surface-elevated rounded-lg p-4 mb-6">
          <p class="text-sm text-secondary mb-2">AI says:</p>
          <p class="text-primary">"Start with a 15lb prime rib as your centerpiece..."</p>
        </div>

        <div class="flex gap-4 justify-center mb-4">
          <button class="bg-success/20 text-success border border-success/30 px-6 py-3 rounded-lg font-medium hover:bg-success/30 transition-micro">
            ✓ Helpful
          </button>
          <button class="bg-danger/20 text-danger border border-danger/30 px-6 py-3 rounded-lg font-medium hover:bg-danger/30 transition-micro">
            ✗ Nope
          </button>
        </div>

        <p class="text-center text-secondary text-sm">
          That's literally it. React to a few, share your take.
        </p>
      </div>

      <div class="space-y-6 text-lg text-secondary">
        <p data-aos="fade-up" data-aos-delay="150">
          You'll see real prompts people ask AI — about gifts, recipes, planning, whatever.
        </p>

        <p data-aos="fade-up" data-aos-delay="200">
          Caught something off? <span class="text-accent font-medium">Flag it</span> and share why. Looks good? <span class="text-accent font-medium">Pass it</span>.
        </p>

        <p class="text-xl text-primary font-medium pt-4 text-center" data-aos="fade-up" data-aos-delay="250">
          Your calls help others know what actually works.
        </p>

        <div class="pt-6 text-center" data-aos="fade-up" data-aos-delay="300">
          <a
            href="/auth"
            class="bg-accent text-accent-on px-8 py-4 rounded-md hover:bg-accent-hover transition-micro ease-smooth font-medium text-lg inline-block"
          >
            Join the Check
          </a>
        </div>

        <div class="pt-4 text-center" data-aos="fade-up" data-aos-delay="350">
          <a
            href="https://humanjudge.com/reports/79ce1f67-0d34-4f99-8738-a9ea98ab1507"
            target="_blank"
            class="inline-flex items-center gap-2 text-accent hover:text-accent-hover transition-micro"
          >
            <span>See Live Results from Other Judges</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
          </a>
        </div>

        <!-- Share Buttons -->
        <div class="pt-8 text-center" data-aos="fade-up" data-aos-delay="400">
          <p class="text-secondary text-sm mb-4">Share this experiment</p>
          <div class="flex flex-wrap justify-center gap-3">
            <a
              href="https://twitter.com/intent/tweet?text=Testing%20if%20GPT-5.2%20actually%20gives%20good%20Christmas%20advice.%20You%20be%20the%20judge%20%E2%86%92%20humanjudge.com%2Ffor-reviewers%2Fchristmas-2025"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 bg-surface-elevated border border-border-subtle text-primary px-3 py-1.5 rounded-md hover:bg-surface-elevated/80 transition-colors text-sm"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              Twitter/X
            </a>
            <a
              href="https://www.linkedin.com/sharing/share-offsite/?url=https%3A%2F%2Fhumanjudge.com%2Ffor-reviewers%2Fchristmas-2025"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 bg-surface-elevated border border-border-subtle text-primary px-3 py-1.5 rounded-md hover:bg-surface-elevated/80 transition-colors text-sm"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
              LinkedIn
            </a>
            <a
              href="https://wa.me/?text=Hey!%20Found%20this%20quick%20thing%20where%20you%20test%20AI%20Christmas%20advice%20(gifts%2C%20cooking%2C%20etc).%20Takes%205%20min.%20Thought%20you%20might%20like%20it%3A%20humanjudge.com%2Ffor-reviewers%2Fchristmas-2025"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 bg-surface-elevated border border-border-subtle text-primary px-3 py-1.5 rounded-md hover:bg-surface-elevated/80 transition-colors text-sm"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              WhatsApp
            </a>
            <button
              id="copy-link-btn"
              class="inline-flex items-center gap-2 bg-surface-elevated border border-border-subtle text-primary px-3 py-1.5 rounded-md hover:bg-surface-elevated/80 transition-colors text-sm"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
              <span id="copy-link-text">Copy Link</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Topics Grid -->
  <section class="pt-8 pb-20 bg-surface-elevated">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h3 class="text-2xl sm:text-3xl font-bold text-center text-primary mb-4" data-aos="fade-up">
        Pick What You Know
      </h3>
      <p class="text-secondary text-center mb-8" data-aos="fade-up" data-aos-delay="50">
        You'll only see prompts in topics you choose.
      </p>

      <div class="grid md:grid-cols-3 gap-6">
        <div class="topic-card bg-surface border border-border-subtle rounded-xl p-6" data-aos="fade-up" data-aos-delay="100">
          <div class="text-4xl mb-4">🍽️</div>
          <h3 class="text-xl font-semibold text-primary mb-2">Food & Cooking</h3>
          <p class="text-secondary">Holiday recipes, budget meals, cooking tips</p>
        </div>

        <div class="topic-card bg-surface border border-border-subtle rounded-xl p-6" data-aos="fade-up" data-aos-delay="150">
          <div class="text-4xl mb-4">🎁</div>
          <h3 class="text-xl font-semibold text-primary mb-2">Gifts & Shopping</h3>
          <p class="text-secondary">Gift ideas, budget recommendations, what to avoid</p>
        </div>

        <div class="topic-card bg-surface border border-border-subtle rounded-xl p-6" data-aos="fade-up" data-aos-delay="200">
          <div class="text-4xl mb-4">🎄</div>
          <h3 class="text-xl font-semibold text-primary mb-2">Decorating & DIY</h3>
          <p class="text-secondary">Home decor, crafts, projects that work</p>
        </div>

        <div class="topic-card bg-surface border border-border-subtle rounded-xl p-6" data-aos="fade-up" data-aos-delay="250">
          <div class="text-4xl mb-4">🎬</div>
          <h3 class="text-xl font-semibold text-primary mb-2">Movies & Entertainment</h3>
          <p class="text-secondary">What to watch, hidden gems, family picks</p>
        </div>

        <div class="topic-card bg-surface border border-border-subtle rounded-xl p-6" data-aos="fade-up" data-aos-delay="300">
          <div class="text-4xl mb-4">📅</div>
          <h3 class="text-xl font-semibold text-primary mb-2">Planning & Logistics</h3>
          <p class="text-secondary">Travel, schedules, getting through the season</p>
        </div>

        <div class="topic-card bg-surface border border-border-subtle rounded-xl p-6" data-aos="fade-up" data-aos-delay="350">
          <div class="text-4xl mb-4">❤️</div>
          <h3 class="text-xl font-semibold text-primary mb-2">Family & Relationships</h3>
          <p class="text-secondary">Navigating dynamics, traditions, the emotional stuff</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. About HumanJudge: Brief intro -->
  <section class="py-16">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="text-xl text-secondary" data-aos="fade-up">
        HumanJudge is independent — not affiliated with OpenAI or any AI lab.
      </p>
    </div>
  </section>

  <!-- Why This Matters (Expandable) -->
  <section class="py-12 border-t border-border-subtle">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <details class="group">
        <summary class="cursor-pointer list-none flex items-center justify-center gap-2 text-secondary hover:text-primary transition-micro">
          <span class="text-lg">Why does this actually matter?</span>
          <svg class="w-5 h-5 transform transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </summary>
        <div class="mt-6 space-y-4 text-secondary">
          <p>
            Beyond the funny fails, AI advice can have real consequences. Researchers have found AI recipes with <a href="https://extension.umn.edu/cottage-food-safety-news/are-recipes-written-ai-safe" target="_blank" rel="noopener noreferrer" class="text-accent hover:text-accent/80">dangerous pH levels</a>, and cooking times that could lead to <a href="https://www.rnz.co.nz/stories/2018882079/chatgpt-a-recipe-for-culinary-disaster" target="_blank" rel="noopener noreferrer" class="text-accent hover:text-accent/80">undercooked poultry</a>.
          </p>
          <p>
            Your quick reality check helps surface patterns — what works, what doesn't, and where people should be careful.
          </p>
        </div>
      </details>
    </div>
  </section>

  <!-- FAQ Section -->
  <div data-aos="fade-up">
    <FAQ
      title="Quick Questions"
      items={[
        {
          question: "Wait, am I qualified for this?",
          answer: "If you've ever cooked a meal, planned a party, or given a gift — yes. We're looking for real-world perspective, not credentials."
        },
        {
          question: "How long does it take?",
          answer: "Most people finish in 5-10 minutes. You can do more if you want, but there's no minimum."
        },
        {
          question: "What happens to my reactions?",
          answer: "They help build a public signal about what AI gets right and wrong. Your name is attached — you're building a track record."
        }
      ]}
    />
  </div>

  <!-- 5. Final CTA: Reinforces agency, simplicity, meaning -->
  <div data-aos="fade-up">
    <CTA
      title="5 Minutes. Real Impact."
      description="You already know what works. Help others see it too."
      primaryButton={{ text: "Join the Check", href: "/auth" }}
      variant="accent"
    />
  </div>

  <!-- AOS Animation Library -->
  <link rel="stylesheet" href="https://unpkg.com/aos@2.3.1/dist/aos.css" />
  <script is:inline src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
  <script is:inline>
    document.addEventListener('DOMContentLoaded', function() {
      // Copy Link button handler
      const copyBtn = document.getElementById('copy-link-btn');
      const copyText = document.getElementById('copy-link-text');
      if (copyBtn && copyText) {
        copyBtn.addEventListener('click', async function() {
          try {
            await navigator.clipboard.writeText('humanjudge.com/ai-reviews/christmas-2025');
            copyText.textContent = 'Copied!';
            setTimeout(() => { copyText.textContent = 'Copy Link'; }, 2000);
          } catch (err) {
            console.error('Failed to copy:', err);
          }
        });
      }

      AOS.init({
        duration: 800,
        easing: 'ease-out-cubic',
        once: true,
        offset: 50
      });

      // Snowfall effect for Hero section only
      const snowfallContainer = document.getElementById('hero-snowfall');
      const christmasEmojis = ['🎄', '🎅', '🎁', '❄️', '🌟', '✨', '🦌', '🔔', '⭐', '🎀', '🧦', '☃️'];
      const rareEmojis = ['🤨', '🤩'];
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (snowfallContainer && !prefersReducedMotion) {
        // Inject keyframe animation into document
        const styleSheet = document.createElement('style');
        styleSheet.textContent = `
          @keyframes snowfallAnim {
            0% { transform: translateY(0) rotate(0deg); opacity: 1; }
            100% { transform: translateY(500px) rotate(360deg); opacity: 0.3; }
          }
        `;
        document.head.appendChild(styleSheet);

        function createSnowflake() {
          const flake = document.createElement('div');
          // 10% chance for rare emojis, 90% for christmas emojis
          const useRare = Math.random() < 0.1;
          flake.textContent = useRare
            ? rareEmojis[Math.floor(Math.random() * rareEmojis.length)]
            : christmasEmojis[Math.floor(Math.random() * christmasEmojis.length)];

          const duration = (Math.random() * 4 + 6);
          const left = Math.random() * 100;
          const size = (Math.random() * 1.5 + 1); // Range: 1rem to 2.5rem
          const opacity = (Math.random() * 0.4 + 0.5);

          // Apply all styles inline to avoid Astro scoping issues
          flake.style.cssText = `
            position: absolute;
            top: -20px;
            left: ${left}%;
            font-size: ${size}rem;
            color: rgba(255, 255, 255, 0.7);
            text-shadow: 0 0 3px rgba(255, 255, 255, 0.3);
            opacity: ${opacity};
            pointer-events: none;
            animation: snowfallAnim ${duration}s linear forwards;
            will-change: transform;
          `;

          snowfallContainer.appendChild(flake);

          // Remove after animation completes
          setTimeout(() => flake.remove(), duration * 1000);
        }

        // Create initial batch
        for (let i = 0; i < 15; i++) {
          setTimeout(createSnowflake, i * 150);
        }

        // Keep creating snowflakes
        setInterval(createSnowflake, 500);
      }
    });
  </script>
</BaseLayout>
