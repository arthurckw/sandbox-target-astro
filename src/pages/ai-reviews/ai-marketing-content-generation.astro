---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTA from '../../components/CTA.astro';

const EVALUATION_ID = '7a97ef08-3d89-42c5-a4db-f6b43b4700ca';
const AUTH_LINK = `/auth?track=empowerment&project=${EVALUATION_ID}`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Human Evaluation Benchmark for AI Marketing and Content Generation",
  "description": "Review AI-generated marketing content — social posts, cold emails, taglines, scripts — and tell us: would it actually work?",
  "url": "https://humanjudge.com/ai-reviews/ai-marketing-content-generation",
  "publisher": {
    "@type": "Organization",
    "name": "HumanJudge",
    "url": "https://humanjudge.com"
  },
  "mainEntity": {
    "@type": "Event",
    "name": "AI Marketing Content Generation Benchmark",
    "description": "Students review AI-generated marketing content and qualify for a Letter of Recommendation.",
    "eventStatus": "https://schema.org/EventScheduled",
    "eventAttendanceMode": "https://schema.org/OnlineEventAttendanceMode",
    "organizer": {
      "@type": "Organization",
      "name": "HumanJudge",
      "url": "https://humanjudge.com"
    },
    "location": {
      "@type": "VirtualLocation",
      "url": "https://humanjudge.com/ai-reviews/ai-marketing-content-generation"
    }
  }
};
---

<BaseLayout
  title="AI Marketing Content Generation Benchmark | HumanJudge"
  description="Review AI-generated marketing content — social posts, cold emails, taglines, scripts — and tell us: would it actually work? Qualify for a Letter of Recommendation."
  keywords="AI marketing, content generation, AI benchmark, human evaluation, AI review, marketing copy, AI content"
  canonicalUrl="https://humanjudge.com/ai-reviews/ai-marketing-content-generation"
  currentPath="/ai-reviews/ai-marketing-content-generation"
  jsonLd={jsonLd}
>

  <!-- Hero -->
  <section class="py-16">
    <div class="max-w-3xl mx-auto px-4 text-center">
      <h1 class="text-3xl sm:text-4xl font-bold text-primary mb-4">
        Human Evaluation Benchmark for AI Marketing and Content Generation
      </h1>
      <p class="text-lg text-secondary mb-8 max-w-xl mx-auto">
        Read AI-generated marketing content — social posts, cold emails, taglines, scripts — and
        tell us: would it actually work? Students who reach AI Reviewer qualify for a
        <span class="text-purple-300 font-semibold"> Letter of Recommendation</span> from our founders.
      </p>

      <a
        href={AUTH_LINK}
        class="inline-flex items-center gap-2 px-8 py-4 text-lg font-semibold rounded-xl bg-accent text-accent-on hover:bg-accent-hover transition-colors"
      >
        Start Reviewing
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
        </svg>
      </a>

      <!-- What you'll evaluate -->
      <div class="mt-16 mb-16">
        <h2 class="text-2xl sm:text-3xl font-bold text-center text-primary mb-4">What You'll Evaluate</h2>
        <p class="text-lg text-secondary text-center mb-8">Real marketing content, generated by AI. You decide if it works.</p>
        <div class="grid sm:grid-cols-2 gap-6 text-left">
          <div class="bg-surface border border-border-subtle rounded-xl p-6">
            <div class="text-3xl mb-3">📣</div>
            <h3 class="text-lg font-semibold text-primary mb-1">Content Engagement</h3>
            <p class="text-secondary">LinkedIn posts, X threads, Reels scripts, blogs</p>
          </div>
          <div class="bg-surface border border-border-subtle rounded-xl p-6">
            <div class="text-3xl mb-3">📧</div>
            <h3 class="text-lg font-semibold text-primary mb-1">Leads & Outreach</h3>
            <p class="text-secondary">Cold emails, re-engagement, lead generation</p>
          </div>
          <div class="bg-surface border border-border-subtle rounded-xl p-6">
            <div class="text-3xl mb-3">💡</div>
            <h3 class="text-lg font-semibold text-primary mb-1">Content Strategy</h3>
            <p class="text-secondary">Taglines, channel recommendations</p>
          </div>
          <div class="bg-surface border border-border-subtle rounded-xl p-6">
            <div class="text-3xl mb-3">🛡️</div>
            <h3 class="text-lg font-semibold text-primary mb-1">Guardrails</h3>
            <p class="text-secondary">Does AI refuse illegal or misleading requests?</p>
          </div>
        </div>
      </div>

      <!-- How it works -->
      <h2 class="text-2xl sm:text-3xl font-bold text-center text-primary mb-4">How It Works</h2>
      <p class="text-lg text-secondary text-center mb-8">Three steps. No prep needed.</p>
      <div class="grid sm:grid-cols-3 gap-6 text-left mb-16">
        <div class="bg-surface border border-border-subtle rounded-xl p-6">
          <div class="text-3xl mb-3">💬</div>
          <h3 class="text-lg font-semibold text-primary mb-2">Read & Judge</h3>
          <p class="text-secondary">Read AI-generated marketing copy and ask yourself: would I stop scrolling? Would I click? Would I buy? If yes — pass. If not — flag and explain why.</p>
        </div>
        <div class="bg-surface border border-border-subtle rounded-xl p-6">
          <div class="text-3xl mb-3">⭐</div>
          <h3 class="text-lg font-semibold text-primary mb-2">Level Up</h3>
          <p class="text-secondary">Each review earns XP. Complete reviews to progress from Guest to AI Reviewer (Provisional) to AI Reviewer.</p>
        </div>
        <div class="bg-surface border border-border-subtle rounded-xl p-6">
          <div class="text-3xl mb-3">🎓</div>
          <h3 class="text-lg font-semibold text-primary mb-2">Get a Letter</h3>
          <p class="text-secondary">Reach AI Reviewer status and qualify for a Letter of Recommendation for your portfolio.</p>
        </div>
      </div>

    </div>
  </section>

  <!-- Developer CTA -->
  <CTA
    title="Building an AI Marketing Tool?"
    description="Submit your AI to this benchmark. Get real human feedback on your outputs, discover where your model falls short, and gain early users who care about quality."
    primaryButton={{ text: "Book a Free Call", href: "https://calendly.com/humanjudge/new-meeting" }}
    variant="accent"
  />

</BaseLayout>
