<!-- PBI-041: live-counter animation for the Evaluations stat.
     Starts ~5 mins behind the real target (offset of 300) and ticks
     +1 every second for 5 minutes — feels like votes are streaming
     in live on the page. Commercial LLMs + Domains numbers are static. -->
<script is:inline>
(function(){
  const fmt = (n) => n.toLocaleString();
  const OFFSET = 900;       // start this many below target
  const TICK_MS = 333;      // +1 ~3 times per second (≈5 min to land)

  function animate(el) {
    if (el.dataset.animated === '1') return;
    const target = parseInt(el.getAttribute('data-count-to'), 10);
    if (!target) return;
    el.dataset.animated = '1';
    let current = Math.max(0, target - OFFSET);
    el.textContent = fmt(current);
    const id = setInterval(() => {
      current += 1;
      if (current >= target) {
        el.textContent = fmt(target);
        clearInterval(id);
      } else {
        el.textContent = fmt(current);
      }
    }, TICK_MS);
  }

  const targets = document.querySelectorAll('[data-count-to]');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          animate(e.target);
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.5 });
    targets.forEach(el => io.observe(el));
  } else {
    targets.forEach(animate);
  }
})();
</script>

<style is:global>
  /* Hide the horizontal scrollbar on the arenas scroller. Native swipe
     still works on mobile; desktop users page via prev/next arrows. */
  .arena-scroller::-webkit-scrollbar { display: none; }
  .arena-scroller { -ms-overflow-style: none; scrollbar-width: none; }

  /* Proximity snap removed — felt like force pull-back rather than
     subtle alignment because the browser's snap threshold isn't tunable
     and engages too aggressively on long sections. Free scroll feels
     better on a content-dense landing. */
</style>

<!-- AI Arenas horizontal scroll navigation. -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const scroller = document.getElementById('challenge-grid') as HTMLElement | null;
    const prevBtn = document.getElementById('arenas-prev') as HTMLButtonElement | null;
    const nextBtn = document.getElementById('arenas-next') as HTMLButtonElement | null;
    if (!scroller) return;

    updateArrows();

    function pageBy(direction: -1 | 1) {
      if (!scroller) return;
      const card = scroller.querySelector('.challenge-card') as HTMLElement | null;
      if (!card) return;
      const cardWidth = card.offsetWidth + 24; // card + gap-6 (24px)
      const visible = Math.max(1, Math.floor(scroller.clientWidth / cardWidth));
      scroller.scrollBy({ left: direction * cardWidth * visible, behavior: 'smooth' });
    }

    prevBtn?.addEventListener('click', () => pageBy(-1));
    nextBtn?.addEventListener('click', () => pageBy(1));
    scroller.addEventListener('scroll', updateArrows, { passive: true });
    window.addEventListener('resize', updateArrows);

    function updateArrows() {
      if (!scroller || !prevBtn || !nextBtn) return;
      const atStart = scroller.scrollLeft <= 2;
      const atEnd = scroller.scrollLeft + scroller.clientWidth >= scroller.scrollWidth - 2;
      prevBtn.disabled = atStart;
      nextBtn.disabled = atEnd;
    }
  });
</script>

