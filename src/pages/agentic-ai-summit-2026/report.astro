---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';

// Marketing benchmark leaderboard — pulled from production DB 2026-07-24.
// Source query joins human_evaluations → traces → models on evaluation_id
// = 7a97ef08-3d89-42c5-a4db-f6b43b4700ca. Only models with n >= 50 shown.
type Row = { model: string; provider: string; kind: 'llm' | 'vertical'; passRate: number; votes: number };
const leaderboard: Row[] = [
  { model: 'GPT-5.2 Chat',              provider: 'OpenAI',      kind: 'llm',      passRate: 94.22, votes: 1868 },
  { model: 'Gemini 3.1 Pro Preview',    provider: 'Google',      kind: 'llm',      passRate: 94.03, votes: 1858 },
  { model: 'GPT-5.4',                   provider: 'OpenAI',      kind: 'llm',      passRate: 93.79, votes:  869 },
  { model: 'GPT-5.2',                   provider: 'OpenAI',      kind: 'llm',      passRate: 92.98, votes: 1852 },
  { model: 'Gemini 3 Flash Preview',    provider: 'Google',      kind: 'llm',      passRate: 91.87, votes: 1857 },
  { model: 'Claude Opus 4.6',           provider: 'Anthropic',   kind: 'llm',      passRate: 91.85, votes: 1865 },
  { model: 'Claude Sonnet 4.6',         provider: 'Anthropic',   kind: 'llm',      passRate: 91.60, votes: 1869 },
  { model: 'Palmyra Creative',          provider: 'WRITER',      kind: 'vertical', passRate: 90.91, votes:   55 },
  { model: 'Grok 4.1 Fast',             provider: 'xAI',         kind: 'llm',      passRate: 90.36, votes: 1856 },
  { model: 'Grok 4',                    provider: 'xAI',         kind: 'llm',      passRate: 89.35, votes: 1860 },
  { model: 'Qwen3 VL 235B',             provider: 'Qwen',        kind: 'llm',      passRate: 88.88, votes: 1861 },
  { model: 'gpt-oss-120b',              provider: 'OpenAI',      kind: 'llm',      passRate: 87.96, votes: 1811 },
  { model: 'GPT-5.5',                   provider: 'OpenAI',      kind: 'llm',      passRate: 86.52, votes:  267 },
  { model: 'Kimi K2.6',                 provider: 'MoonshotAI',  kind: 'llm',      passRate: 86.10, votes:  295 },
  { model: 'Marketeam.ai',              provider: 'Marketeam',   kind: 'vertical', passRate: 83.93, votes:   56 },
  { model: 'Jasper',                    provider: 'Jasper',      kind: 'vertical', passRate: 83.02, votes:   53 },
];
// Aggregate — LLMs vs Vertical agents.
const aggLLM = { pass: 91.30, votes: 20015 };
const aggVertical = { pass: 85.98, votes: 164 };
// Dot plot x-axis: 82-96% band. Precompute normalized x for each model.
const xMin = 82, xMax = 96;
const xPct = (v: number) => ((v - xMin) / (xMax - xMin)) * 100;
---

<BaseLayout
