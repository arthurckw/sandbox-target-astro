---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import FAQ from '../../components/FAQ.astro';
import CTA from '../../components/CTA.astro';
---

<BaseLayout
  title="Build Your AI Agent for FREE | HumanJudge"
  description="We help non-technical founders build AI agents with human-in-the-loop evaluation built in. Get a working MVP deployed - for free."
  currentPath="/for-founders"
  keywords="build AI agent free, AI MVP development, non-technical founder AI, free AI builder, AI agent for startups, human-in-the-loop AI, AI for small business"
>
  <!-- Canonical URL -->
  <link slot="head" rel="canonical" href="https://humanjudge.com/for-founders" />

  <!-- Service Schema for SEO -->
  <script type="application/ld+json" slot="head">
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Free AI Agent Development",
    "provider": {
      "@type": "Organization",
      "name": "HumanJudge"
    },
    "description": "We build AI agents for non-technical founders with human-in-the-loop evaluation built in - for free.",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "areaServed": "Worldwide"
  }
  </script>

  <!-- FAQ Schema for SEO -->
  <script type="application/ld+json" slot="head">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What do I need to get started?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Just an idea for an AI agent and 30 minutes for a discovery call. We handle the technical side."
        }
      },
      {
        "@type": "Question",
        "name": "Why is this free?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "We're building case studies and early testimonials. You get a working product, we get a reference and letter of interest."
        }
      },
      {
        "@type": "Question",
        "name": "What's the catch?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "No catch. We ask for a letter of interest and permission to use your project as a case study. That's it."
        }
      },
      {
        "@type": "Question",
        "name": "What is HumanJudge?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "HumanJudge is human-in-the-loop evaluation for AI. It catches AI mistakes before your users see them. We build it into your agent from day one."
        }
      }
    ]
  }
  </script>

  <!-- Hero Section -->
  <section class="py-16 sm:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <!-- Left: Text Content -->
        <div class="text-center lg:text-left">
          <div class="inline-flex items-center px-3 py-1 rounded-full bg-accent/10 text-accent text-sm font-medium mb-4">
            Limited Spots Available
          </div>
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-primary leading-tight mb-6">
            Build Your AI Agent.<br/>
            <span class="text-accent">For Free.</span>
          </h1>
          <p class="text-xl text-secondary max-w-xl mx-auto lg:mx-0 mb-4">
            You have an AI product idea but can't code it yourself. Agencies want $50k. No-code tools don't cut it. Finding a technical co-founder takes months.
          </p>
          <p class="text-lg text-primary font-medium max-w-xl mx-auto lg:mx-0 mb-8">
            We'll build your MVP AI agent and deploy it — with human-in-the-loop evaluation built in from day one.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
            <a
              href="https://calendly.com/humanjudge/new-meeting"
              target="_blank"
              rel="noopener noreferrer"
              class="bg-accent text-accent-on px-8 py-4 rounded-md hover:bg-accent-hover transition-micro ease-smooth font-medium text-lg inline-block text-center"
            >
              Book a Free Call
            </a>
            <a
              href="#how-it-works"
              class="border border-border-emphasis text-primary px-8 py-4 rounded-md hover:bg-surface-elevated transition-micro ease-smooth font-medium text-lg inline-block text-center"
            >
              How It Works
            </a>
          </div>
        </div>

        <!-- Right: Visual Element -->
        <div class="order-first lg:order-last">
          <div class="bg-surface-elevated border border-border-subtle rounded-2xl p-8 max-w-md mx-auto">
            <div class="space-y-4">
              <!-- What you get card -->
              <div class="bg-surface border border-accent/30 rounded-lg p-4">
                <p class="text-sm text-secondary mb-3">What you get:</p>
                <ul class="space-y-2">
                  <li class="flex items-center gap-2 text-primary">
                    <span class="text-accent">✓</span>
                    Working AI agent deployed
                  </li>
                  <li class="flex items-center gap-2 text-primary">
                    <span class="text-accent">✓</span>
                    Human review built in
                  </li>
                  <li class="flex items-center gap-2 text-primary">
                    <span class="text-accent">✓</span>
                    Error monitoring dashboard
                  </li>
                  <li class="flex items-center gap-2 text-primary">
                    <span class="text-accent">✓</span>
                    Ready to show investors
                  </li>
                </ul>
              </div>
              <!-- What we ask -->
              <div class="bg-surface border border-border-subtle rounded-lg p-4 opacity-80">
                <p class="text-sm text-secondary mb-3">What we ask:</p>
                <ul class="space-y-2">
                  <li class="flex items-center gap-2 text-secondary">
                    <span>→</span>
                    Letter of interest
                  </li>
                  <li class="flex items-center gap-2 text-secondary">
                    <span>→</span>
                    Permission to use as case study
                  </li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Who This Is For -->
  <section class="py-16 bg-surface-elevated border-y border-border-subtle">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-bold text-primary text-center mb-4">
        Who This Is For
      </h2>
      <p class="text-secondary text-center mb-12 max-w-2xl mx-auto">
        If you have an AI idea but need technical help to ship it.
      </p>

      <div class="grid md:grid-cols-3 gap-8">
        <!-- Non-Technical Founders -->
        <div class="bg-surface border border-border-subtle rounded-xl p-8 hover:border-accent/50 transition-colors">
          <div class="w-14 h-14 bg-accent/10 rounded-xl flex items-center justify-center text-3xl mb-6">
            💡
          </div>
          <h3 class="text-xl font-semibold text-primary mb-3">Non-Technical Founders</h3>
          <p class="text-secondary mb-4">
            You have the vision and the domain knowledge. You just need someone to build it.
          </p>
          <div class="border-t border-border-subtle pt-4 mt-4">
            <p class="text-primary font-medium mb-2">Common situation:</p>
            <p class="text-sm text-secondary">
              "I know exactly what my AI should do, but I can't code it myself and agencies want $50k."
            </p>
          </div>
        </div>

        <!-- Small Business Owners -->
        <div class="bg-surface border border-border-subtle rounded-xl p-8 hover:border-accent/50 transition-colors">
          <div class="w-14 h-14 bg-accent/10 rounded-xl flex items-center justify-center text-3xl mb-6">
            🏪
          </div>
          <h3 class="text-xl font-semibold text-primary mb-3">Small Business Owners</h3>
          <p class="text-secondary mb-4">
            You see AI everywhere and want to add it to your business. But where do you even start?
          </p>
          <div class="border-t border-border-subtle pt-4 mt-4">
            <p class="text-primary font-medium mb-2">Common situation:</p>
            <p class="text-sm text-secondary">
              "I want an AI assistant for my customers but I don't know how to build one."
            </p>
          </div>
        </div>

        <!-- Health & Education Leaders -->
        <div class="bg-surface border border-border-subtle rounded-xl p-8 hover:border-accent/50 transition-colors">
          <div class="w-14 h-14 bg-accent/10 rounded-xl flex items-center justify-center text-3xl mb-6">
            🏥
          </div>
          <h3 class="text-xl font-semibold text-primary mb-3">Health & Education</h3>
          <p class="text-secondary mb-4">
            You need AI that won't make dangerous mistakes. Human oversight isn't optional — it's required.
          </p>
          <div class="border-t border-border-subtle pt-4 mt-4">
            <p class="text-primary font-medium mb-2">Why it matters:</p>
            <p class="text-sm text-secondary">
              HIPAA, COPPA, compliance — when you scale, human-in-the-loop becomes critical.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- How It Works -->
  <section id="how-it-works" class="py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-bold text-primary text-center mb-4">
        How It Works
      </h2>
      <p class="text-secondary text-center mb-12 max-w-2xl mx-auto">
        From idea to deployed AI agent. We handle the technical work.
      </p>

      <div class="relative">
        <!-- Connecting line (hidden on mobile) -->
        <div class="hidden md:block absolute top-8 left-[16.67%] right-[16.67%] h-0.5 bg-gradient-to-r from-accent/20 via-accent to-accent/20 z-0"></div>

        <div class="grid md:grid-cols-3 gap-8">
          <!-- Step 1 -->
          <div class="relative text-center">
            <div class="w-16 h-16 bg-surface border-2 border-accent rounded-full flex items-center justify-center mx-auto mb-6 relative z-10">
              <span class="text-2xl font-bold text-accent">1</span>
            </div>
            <h3 class="text-xl font-semibold text-primary mb-3">Discovery Call</h3>
            <p class="text-secondary">
              30-minute call to understand your idea. What should the AI do? Who are your users? We scope the MVP together.
            </p>
          </div>

          <!-- Step 2 -->
          <div class="relative text-center">
            <div class="w-16 h-16 bg-surface border-2 border-accent rounded-full flex items-center justify-center mx-auto mb-6 relative z-10">
              <span class="text-2xl font-bold text-accent">2</span>
            </div>
            <h3 class="text-xl font-semibold text-primary mb-3">We Build It</h3>
            <p class="text-secondary">
              We build your AI agent with HumanJudge integrated. Human-in-the-loop evaluation catches errors before users see them.
            </p>
          </div>

          <!-- Step 3 -->
          <div class="relative text-center">
            <div class="w-16 h-16 bg-surface border-2 border-accent rounded-full flex items-center justify-center mx-auto mb-6 relative z-10">
              <span class="text-2xl font-bold text-accent">3</span>
            </div>
            <h3 class="text-xl font-semibold text-primary mb-3">You Ship</h3>
            <p class="text-secondary">
              We deploy to your cloud. You get a working product to show investors, customers, or stakeholders.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What You Get -->
  <section class="py-20 bg-surface-elevated">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-bold text-primary text-center mb-4">
        What You Get
      </h2>
      <p class="text-secondary text-center mb-12 max-w-2xl mx-auto">
        A working product now. Built-in value when you scale.
      </p>

      <div class="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto">
        <!-- Now -->
        <div class="bg-surface border border-accent/30 rounded-xl p-8">
          <div class="inline-flex items-center px-3 py-1 rounded-full bg-accent/10 text-accent text-sm font-medium mb-4">
            Now
          </div>
          <h3 class="text-2xl font-semibold text-primary mb-4">Working MVP Deployed</h3>
          <ul class="space-y-3">
            <li class="flex items-start gap-3 text-secondary">
              <span class="text-accent text-lg">→</span>
              AI agent built to your specifications
            </li>
            <li class="flex items-start gap-3 text-secondary">
              <span class="text-accent text-lg">→</span>
              Deployed and ready to use
            </li>
            <li class="flex items-start gap-3 text-secondary">
              <span class="text-accent text-lg">→</span>
              HumanJudge evaluation dashboard
            </li>
            <li class="flex items-start gap-3 text-secondary">
              <span class="text-accent text-lg">→</span>
              Something real to show investors
            </li>
          </ul>
        </div>

        <!-- Future -->
        <div class="bg-surface border border-border-subtle rounded-xl p-8">
          <div class="inline-flex items-center px-3 py-1 rounded-full bg-surface-elevated text-secondary text-sm font-medium mb-4">
            When You Scale
          </div>
          <h3 class="text-2xl font-semibold text-primary mb-4">Human-in-the-Loop Value</h3>
          <ul class="space-y-3">
            <li class="flex items-start gap-3 text-secondary">
              <span class="text-secondary text-lg">→</span>
              Catch AI errors before users see them
            </li>
            <li class="flex items-start gap-3 text-secondary">
              <span class="text-secondary text-lg">→</span>
              Compliance-ready (HIPAA, COPPA)
            </li>
            <li class="flex items-start gap-3 text-secondary">
              <span class="text-secondary text-lg">→</span>
              Trust signals for enterprise customers
            </li>
            <li class="flex items-start gap-3 text-secondary">
              <span class="text-secondary text-lg">→</span>
              Quality monitoring as you grow
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Us vs Alternatives -->
  <section class="py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-bold text-primary text-center mb-4">
        Why This Instead of...
      </h2>
      <p class="text-xl text-secondary text-center max-w-3xl mx-auto mb-12">
        You have options. Here's how we compare.
      </p>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 max-w-5xl mx-auto">
        <!-- vs Agency -->
        <div class="bg-surface border border-border-subtle rounded-lg p-6">
          <h3 class="text-lg font-semibold text-primary mb-2">AI Dev Agency</h3>
          <p class="text-sm text-secondary mb-4">$5k - $50k+ for an MVP</p>
          <div class="border-t border-border-subtle pt-4">
            <p class="text-sm text-accent font-medium">We're free.</p>
            <p class="text-xs text-secondary mt-1">Same result, no cost.</p>
          </div>
        </div>

        <!-- vs No-Code -->
        <div class="bg-surface border border-border-subtle rounded-lg p-6">
          <h3 class="text-lg font-semibold text-primary mb-2">No-Code Tools</h3>
          <p class="text-sm text-secondary mb-4">Limited, frustrating, can't do what you need</p>
          <div class="border-t border-border-subtle pt-4">
            <p class="text-sm text-accent font-medium">We build it custom.</p>
            <p class="text-xs text-secondary mt-1">Exactly what you need.</p>
          </div>
        </div>

        <!-- vs Co-founder -->
        <div class="bg-surface border border-border-subtle rounded-lg p-6">
          <h3 class="text-lg font-semibold text-primary mb-2">Find Co-founder</h3>
          <p class="text-sm text-secondary mb-4">Takes months, equity concerns</p>
          <div class="border-t border-border-subtle pt-4">
            <p class="text-sm text-accent font-medium">We're available now.</p>
            <p class="text-xs text-secondary mt-1">No equity required.</p>
          </div>
        </div>

        <!-- vs Waiting -->
        <div class="bg-surface border border-border-subtle rounded-lg p-6">
          <h3 class="text-lg font-semibold text-primary mb-2">Wait Until Later</h3>
          <p class="text-sm text-secondary mb-4">Nothing happens, idea stays an idea</p>
          <div class="border-t border-border-subtle pt-4">
            <p class="text-sm text-accent font-medium">Ship now.</p>
            <p class="text-xs text-secondary mt-1">Iterate later.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Related Pages (Internal Linking) -->
  <section class="py-12 bg-surface-elevated border-y border-border-subtle">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-center text-secondary mb-6">Looking for something else?</p>
      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/for-developers"
          class="text-accent hover:text-accent-hover transition-colors font-medium"
        >
          For Developers →
        </a>
        <span class="text-border-emphasis">|</span>
        <a
          href="/ai-reviews"
          class="text-accent hover:text-accent-hover transition-colors font-medium"
        >
          Browse Topics →
        </a>
        <span class="text-border-emphasis">|</span>
        <a
          href="/about"
          class="text-accent hover:text-accent-hover transition-colors font-medium"
        >
          About HumanJudge →
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <FAQ
    title="Questions"
    items={[
      {
        question: "What do I need to get started?",
        answer: "Just an idea for an AI agent and 30 minutes for a discovery call. We handle the technical side."
      },
      {
        question: "Why is this free?",
        answer: "We're building case studies and early testimonials. You get a working product, we get a reference and letter of interest."
      },
      {
        question: "What's the catch?",
        answer: "No catch. We ask for a letter of interest and permission to use your project as a case study. That's it."
      },
      {
        question: "What is HumanJudge?",
        answer: "HumanJudge is human-in-the-loop evaluation for AI. It catches AI mistakes before your users see them. We build it into your agent from day one."
      },
      {
        question: "How long does it take?",
        answer: "Depends on complexity. Simple agents can be ready in days. We'll give you a timeline on the discovery call."
      },
      {
        question: "Do I own the code?",
        answer: "Yes. It's deployed to your cloud, you own everything. HumanJudge is a service layer that helps you monitor quality."
      }
    ]}
  />

  <!-- Final CTA -->
  <CTA
    title="Ready to Ship Your AI Product?"
    description="Book a free 30-minute call. We'll scope your MVP and get you from idea to deployed AI agent."
    primaryButton={{ text: "Book a Free Call", href: "https://calendly.com/humanjudge/new-meeting" }}
    variant="accent"
  />
</BaseLayout>
