---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import FlowDiagram from '../components/FlowDiagram.astro';
import SimpleFlowCircles from '../components/SimpleFlowCircles.astro';
import TrustComparison from '../components/TrustComparison.astro';
import FAQ from '../components/FAQ.astro';
import CTA from '../components/CTA.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "HumanJudge Developer Platform",
  "applicationCategory": "DeveloperApplication",
  "operatingSystem": "Web",
  "url": "https://humanjudge.com/for-developers",
  "description": "Get human evaluation for your AI model. Register your model, enroll in public benchmarks, and receive pass/flag votes from verified human reviewers. Supports OpenAI-compatible endpoints, Python SDK tracing, and Chrome Extension review. Results available via API, Jupyter notebooks, and public leaderboards.",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD",
    "description": "Free benchmark enrollment. Human reviewers evaluate your AI outputs."
  },
  "featureList": [
    "Public AI benchmarks with human reviewers",
    "Python SDK for trace ingestion (pip install grandjury)",
    "JavaScript SDK for frontend integration",
    "Chrome Extension for in-context review",
    "Jupyter notebook integration with pandas/polars",
    "Public leaderboard and model comparison",
    "Standalone evaluation projects",
    "Personal Access Token for programmatic access"
  ],
  "provider": {
    "@type": "Organization",
    "name": "HumanJudge",
    "url": "https://humanjudge.com"
  }
};
---

<BaseLayout
  title="For Developers | Get Human Evaluation for Your AI Model | HumanJudge"
  description="Get human evaluation for your AI model. Register your model, enroll in public benchmarks, receive pass/flag votes from verified reviewers. Free. Python SDK, Jupyter, Chrome Extension."
  currentPath="/for-developers"
  jsonLd={jsonLd}
>
  <!-- Hero with 2-column layout -->
  <section class="py-16 sm:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <!-- Left: Text Content -->
        <div class="text-center lg:text-left">
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-primary leading-tight mb-6">
            Build Trust with<br/>Live Human-in-the-loop (HITL)
          </h1>
          <p class="text-xl text-secondary max-w-xl mx-auto lg:mx-0 mb-8">
            Attribute your product value with trust factor.<br/>
            Improve your prompts and RAG with live signals.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
            <a
              href="/auth?role=builder"
              class="bg-accent text-accent-on px-8 py-4 rounded-md hover:bg-accent-hover transition-micro ease-smooth font-medium text-lg inline-block text-center"
            >
              Sign Up
            </a>
            <a
              href="#how-it-works"
              class="border border-border-emphasis text-primary px-8 py-4 rounded-md hover:bg-surface-elevated transition-micro ease-smooth font-medium text-lg inline-block text-center"
            >
              How It Works ↓
            </a>
          </div>
        </div>

        <!-- Right: Simple Flow Diagram -->
        <div class="order-first lg:order-last">
          <SimpleFlowCircles />
        </div>
      </div>
    </div>
  </section>

  <!-- Trust Comparison: Visual Before/After -->
  <section class="py-16 bg-surface-elevated border-y border-border-subtle">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl sm:text-3xl font-bold text-primary text-center mb-4">
        The Trust Gap
      </h2>
      <p class="text-secondary text-center mb-10 max-w-2xl mx-auto">
        Your AI works. But how do users know? Metrics don't build trust—humans do.
      </p>

      <TrustComparison />
    </div>
  </section>

  <!-- How It Works - Visual Steps -->
  <section id="how-it-works" class="py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-bold text-primary text-center mb-4">
        How It Works
      </h2>
      <p class="text-secondary text-center mb-12 max-w-2xl mx-auto">
        Add one SDK. Get continuous expert feedback. Show users proof.
      </p>

      <div class="relative">
        <!-- Connecting line (hidden on mobile) - positioned behind circles -->
        <div class="hidden md:block absolute top-8 left-[16.67%] right-[16.67%] h-0.5 bg-gradient-to-r from-accent/20 via-accent to-accent/20 z-0"></div>

        <div class="grid md:grid-cols-3 gap-8">
          <!-- Step 1 -->
          <div class="relative text-center">
            <div class="w-16 h-16 bg-surface border-2 border-accent rounded-full flex items-center justify-center mx-auto mb-6 relative z-10">
              <span class="text-2xl font-bold text-accent">1</span>
            </div>
            <h3 class="text-xl font-semibold text-primary mb-3">Add SDK</h3>
            <p class="text-secondary mb-4">
              One script tag. Works with your existing Langfuse setup.
            </p>
            <div class="bg-surface-elevated border border-border-subtle rounded-lg p-3 text-left">
              <code class="text-xs text-accent">&lt;script src="grandjury.min.js"&gt;</code>
            </div>
            <a href="/docs/get-started" class="text-accent hover:text-accent-hover text-sm mt-3 inline-block">
              Read docs →
            </a>
          </div>

          <!-- Step 2 -->
          <div class="relative text-center">
            <div class="w-16 h-16 bg-surface border-2 border-accent rounded-full flex items-center justify-center mx-auto mb-6 relative z-10">
              <span class="text-2xl font-bold text-accent">2</span>
            </div>
            <h3 class="text-xl font-semibold text-primary mb-3">Get Reviewed</h3>
            <p class="text-secondary mb-4">
              Domain-matched Reviewers judge outputs as they happen.
            </p>
            <div class="flex justify-center gap-2 mt-3">
              <span class="bg-surface-elevated border border-border-subtle rounded-full px-3 py-1 text-xs text-secondary">👨‍⚕️ Medical</span>
              <span class="bg-surface-elevated border border-border-subtle rounded-full px-3 py-1 text-xs text-secondary">⚖️ Legal</span>
              <span class="bg-surface-elevated border border-border-subtle rounded-full px-3 py-1 text-xs text-secondary">💻 Code</span>
            </div>
          </div>

          <!-- Step 3 -->
          <div class="relative text-center">
            <div class="w-16 h-16 bg-surface border-2 border-accent rounded-full flex items-center justify-center mx-auto mb-6 relative z-10">
              <span class="text-2xl font-bold text-accent">3</span>
            </div>
            <h3 class="text-xl font-semibold text-primary mb-3">Trust Visible</h3>
            <p class="text-secondary mb-4">
              Scores sync to Langfuse. Public page shows expert verdicts.
            </p>
            <div class="bg-surface-elevated border border-border-subtle rounded-lg p-3">
              <div class="flex items-center justify-center gap-2">
                <span class="w-3 h-3 bg-success rounded-full"></span>
                <span class="text-sm text-primary font-medium">92% Expert Verified</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Features - Icon Grid -->
  <section class="py-20 bg-surface-elevated">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-primary text-center mb-12">
        What You Get
      </h2>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 max-w-5xl mx-auto">
        <div class="bg-surface border border-border-subtle rounded-lg p-6 hover:border-accent/30 transition-colors">
          <div class="w-12 h-12 bg-accent/10 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-primary mb-2">Real-time Feedback</h3>
          <p class="text-secondary text-sm">Continuous expert evaluation as outputs arrive.</p>
        </div>

        <div class="bg-surface border border-border-subtle rounded-lg p-6 hover:border-accent/30 transition-colors">
          <div class="w-12 h-12 bg-accent/10 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-primary mb-2">Langfuse Integration</h3>
          <p class="text-secondary text-sm">Scores sync to your existing dashboard.</p>
        </div>

        <div class="bg-surface border border-border-subtle rounded-lg p-6 hover:border-accent/30 transition-colors">
          <div class="w-12 h-12 bg-accent/10 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-primary mb-2">Verified Experts</h3>
          <p class="text-secondary text-sm">Credentialed professionals, not crowd workers.</p>
        </div>

        <div class="bg-surface border border-border-subtle rounded-lg p-6 hover:border-accent/30 transition-colors">
          <div class="w-12 h-12 bg-accent/10 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-primary mb-2">Public Proof</h3>
          <p class="text-secondary text-sm">Transparent evaluation pages for users.</p>
        </div>

        <div class="bg-surface border border-border-subtle rounded-lg p-6 hover:border-accent/30 transition-colors">
          <div class="w-12 h-12 bg-accent/10 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-primary mb-2">Early Alerts</h3>
          <p class="text-secondary text-sm">Catch issues before users complain.</p>
        </div>

        <div class="bg-surface border border-border-subtle rounded-lg p-6 hover:border-accent/30 transition-colors">
          <div class="w-12 h-12 bg-accent/10 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-primary mb-2">Trust Badge</h3>
          <p class="text-secondary text-sm">Earn "HumanJudge Verified" after thresholds.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Access from your tools -->
  <section class="py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-primary text-center mb-4">
        Access the data from where you work
      </h2>
      <p class="text-secondary text-center mb-12 max-w-2xl mx-auto">
        Once your AI is registered, query results from ChatGPT, Claude, Python, or Claude Code — same human evaluation data, no context switching.
      </p>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <a href="/docs/pulse/chatgpt" class="block bg-surface-elevated border border-border-subtle rounded-lg p-5 hover:border-accent/50 transition-colors group">
          <h3 class="font-semibold text-primary group-hover:text-accent mb-2">In ChatGPT →</h3>
          <p class="text-secondary text-sm">Free GPT in the GPT Store. Ask plain-English questions about model quality.</p>
        </a>
        <a href="/docs/pulse/claude-desktop" class="block bg-surface-elevated border border-border-subtle rounded-lg p-5 hover:border-accent/50 transition-colors group">
          <h3 class="font-semibold text-primary group-hover:text-accent mb-2">In Claude Desktop →</h3>
          <p class="text-secondary text-sm">Add HumanJudge as a custom MCP connector. 30-second setup.</p>
        </a>
        <a href="/docs/pulse/claude-code" class="block bg-surface-elevated border border-border-subtle rounded-lg p-5 hover:border-accent/50 transition-colors group">
          <h3 class="font-semibold text-primary group-hover:text-accent mb-2">In Claude Code →</h3>
          <p class="text-secondary text-sm">Remote MCP server in <code class="text-accent text-xs">.mcp.json</code>. VS Code or CLI.</p>
        </a>
        <a href="/docs/pulse/python-sdk" class="block bg-surface-elevated border border-border-subtle rounded-lg p-5 hover:border-accent/50 transition-colors group">
          <h3 class="font-semibold text-primary group-hover:text-accent mb-2">In Python →</h3>
          <p class="text-secondary text-sm"><code class="text-accent text-xs">pip install grandjury</code>. Pandas-friendly. Built for notebooks.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- Use Cases -->
  <section class="py-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-primary text-center mb-4">
        Where Trust Matters Most
      </h2>
      <p class="text-secondary text-center mb-12 max-w-2xl mx-auto">
        High-stakes AI needs human proof. Real-time HITL delivers it.
      </p>

      <div class="grid sm:grid-cols-2 gap-6">
        <div class="flex items-start gap-4 bg-surface-elevated border border-border-subtle rounded-lg p-5">
          <span class="text-2xl">🏥</span>
          <div>
            <h3 class="font-semibold text-primary mb-1">Medical AI</h3>
            <p class="text-secondary text-sm">Doctors verify medical advice accuracy.</p>
          </div>
        </div>

        <div class="flex items-start gap-4 bg-surface-elevated border border-border-subtle rounded-lg p-5">
          <span class="text-2xl">⚖️</span>
          <div>
            <h3 class="font-semibold text-primary mb-1">Legal Tech</h3>
            <p class="text-secondary text-sm">Lawyers validate legal reasoning.</p>
          </div>
        </div>

        <div class="flex items-start gap-4 bg-surface-elevated border border-border-subtle rounded-lg p-5">
          <span class="text-2xl">💰</span>
          <div>
            <h3 class="font-semibold text-primary mb-1">Financial AI</h3>
            <p class="text-secondary text-sm">CFPs review financial guidance.</p>
          </div>
        </div>

        <div class="flex items-start gap-4 bg-surface-elevated border border-border-subtle rounded-lg p-5">
          <span class="text-2xl">💻</span>
          <div>
            <h3 class="font-semibold text-primary mb-1">Code Generation</h3>
            <p class="text-secondary text-sm">Engineers catch security issues.</p>
          </div>
        </div>
      </div>

      <!-- Langfuse callout -->
      <div class="mt-8 bg-accent/5 border border-accent/20 rounded-lg p-6 text-center">
        <p class="text-primary font-medium">Already using Langfuse?</p>
        <p class="text-secondary text-sm mt-1">Add trust layer to your existing observability stack.</p>
        <a href="/docs/get-started" class="text-accent hover:text-accent-hover text-sm mt-2 inline-block">See integration guide →</a>
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section class="py-20 bg-surface-elevated">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-primary text-center mb-4">
        Pricing
      </h2>
      <p class="text-secondary text-center mb-12">
        Currently in beta — free for early adopters
      </p>

      <div class="grid md:grid-cols-3 gap-6">
        <!-- Free Tier -->
        <div class="bg-surface border border-accent/30 rounded-lg p-6">
          <div class="inline-flex items-center px-3 py-1 rounded-full bg-accent/10 text-accent text-sm font-medium mb-4">
            Beta Access
          </div>
          <h3 class="text-xl font-semibold text-primary mb-2">Volunteer</h3>
          <p class="text-3xl font-bold text-accent mb-4">Free</p>
          <p class="text-secondary text-sm mb-6">
            Experts evaluate voluntarily. Timing varies.
          </p>
          <ul class="space-y-2 text-sm text-secondary mb-6">
            <li class="flex items-center gap-2"><span class="text-accent">✓</span> Langfuse integration</li>
            <li class="flex items-center gap-2"><span class="text-accent">✓</span> Public evaluation page</li>
            <li class="flex items-center gap-2"><span class="text-accent">✓</span> Verified experts</li>
            <li class="flex items-center gap-2"><span class="text-accent">✓</span> Failure documentation</li>
          </ul>
          <a href="/auth?role=builder" class="bg-accent text-accent-on px-4 py-2 rounded-md hover:bg-accent-hover transition-micro font-medium block text-center">
            Start Free
          </a>
        </div>

        <!-- Paid Tier -->
        <div class="bg-surface border border-border-subtle rounded-lg p-6 opacity-60">
          <div class="inline-flex items-center px-3 py-1 rounded-full bg-surface-elevated text-secondary text-sm font-medium mb-4">
            Coming Soon
          </div>
          <h3 class="text-xl font-semibold text-primary mb-2">Paid</h3>
          <p class="text-3xl font-bold text-secondary mb-4">TBD</p>
          <p class="text-secondary text-sm mb-6">
            Pay for faster turnaround and priority queue.
          </p>
          <ul class="space-y-2 text-sm text-secondary mb-6">
            <li class="flex items-center gap-2"><span class="text-secondary">✓</span> Everything in Free</li>
            <li class="flex items-center gap-2"><span class="text-secondary">✓</span> Priority queue</li>
            <li class="flex items-center gap-2"><span class="text-secondary">✓</span> SLA guarantees</li>
            <li class="flex items-center gap-2"><span class="text-secondary">✓</span> Custom criteria</li>
          </ul>
        </div>

        <!-- Enterprise -->
        <div class="bg-surface border border-border-subtle rounded-lg p-6 opacity-60">
          <div class="inline-flex items-center px-3 py-1 rounded-full bg-surface-elevated text-secondary text-sm font-medium mb-4">
            Coming Soon
          </div>
          <h3 class="text-xl font-semibold text-primary mb-2">Enterprise</h3>
          <p class="text-3xl font-bold text-secondary mb-4">Custom</p>
          <p class="text-secondary text-sm mb-6">
            Dedicated teams, private pages, white-label.
          </p>
          <ul class="space-y-2 text-sm text-secondary mb-6">
            <li class="flex items-center gap-2"><span class="text-secondary">✓</span> Everything in Paid</li>
            <li class="flex items-center gap-2"><span class="text-secondary">✓</span> Dedicated evaluators</li>
            <li class="flex items-center gap-2"><span class="text-secondary">✓</span> Private pages</li>
            <li class="flex items-center gap-2"><span class="text-secondary">✓</span> White-label</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <FAQ
    title="Common Questions"
    items={[
      {
        question: "What is Real-time HITL?",
        answer: "Human-in-the-Loop means real humans evaluate your AI outputs. <strong>Real-time</strong> means this happens continuously as outputs arrive — not one-time batch reviews."
      },
      {
        question: "How does this build trust?",
        answer: "Users trust humans over algorithms. Real-time HITL gives you <strong>public proof</strong> that verified experts continuously evaluate your AI — transforming claims into evidence."
      },
      {
        question: "Does this replace automated testing?",
        answer: "No. Real-time HITL <strong>complements</strong> automated metrics. Machines catch obvious failures; humans provide the trust layer users actually believe."
      },
      {
        question: "Who are the experts?",
        answer: "Verified domain professionals: doctors for medical AI, lawyers for legal AI, engineers for code. Credentials are public — that's how trust is built."
      },
      {
        question: "How does Langfuse integration work?",
        answer: "Outputs flow from Langfuse → evaluation queue → expert reviews → scores sync back to your dashboard automatically."
      }
    ]}
  />

  <!-- Final CTA -->
  <CTA
    title="Stop Saying 'Trust Us.'"
    description="Start proving it with real-time expert feedback."
    primaryButton={{ text: "Sign Up", href: "/auth?role=builder" }}
    secondaryButton={{ text: "Read Docs", href: "/docs/get-started" }}
    variant="accent"
  >
    <p class="text-secondary mt-6">
      Questions? <a href="mailto:support@humanjudge.com" class="text-accent hover:text-accent-hover">support@humanjudge.com</a>
    </p>
  </CTA>
</BaseLayout>
