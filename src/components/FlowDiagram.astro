---
/**
 * Visual architecture flow diagram showing HumanJudge integration
 * 3 parties: AI App → Human Reviewers → HumanJudge (with continuous loop animation)
 */
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class={`flow-diagram ${className}`}>
  <svg viewBox="0 0 700 220" class="w-full h-auto max-w-3xl mx-auto" aria-label="HumanJudge Integration Flow">
    <!-- Definitions -->
    <defs>
      <linearGradient id="accentGradient" x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%" style="stop-color:var(--color-accent);stop-opacity:0.6" />
        <stop offset="100%" style="stop-color:var(--color-accent);stop-opacity:1" />
      </linearGradient>

      <marker id="arrowhead" markerWidth="10" markerHeight="7" refX="9" refY="3.5" orient="auto">
        <polygon points="0 0, 10 3.5, 0 7" fill="var(--color-accent)" opacity="0.8" />
      </marker>
    </defs>

    <!-- Box 1: Your AI App -->
    <g class="flow-box flow-box-1">
      <rect x="30" y="60" width="160" height="90" rx="12"
        fill="var(--bg-surface-elevated)"
        stroke="var(--border-subtle)"
        stroke-width="2" />
      <text x="110" y="100" text-anchor="middle" fill="var(--text-primary)" font-size="15" font-weight="600">Your AI App</text>
      <text x="110" y="122" text-anchor="middle" fill="var(--text-secondary)" font-size="12">Sends outputs</text>
    </g>

    <!-- Arrow 1 → 2 -->
    <path class="flow-arrow" d="M190 105 L260 105"
      stroke="url(#accentGradient)" stroke-width="2.5" fill="none"
      marker-end="url(#arrowhead)" />

    <!-- Box 2: Human Reviewers -->
    <g class="flow-box flow-box-2">
      <rect x="260" y="60" width="160" height="90" rx="12"
        fill="var(--bg-surface-elevated)"
        stroke="var(--border-subtle)"
        stroke-width="2" />
      <!-- Person icons -->
      <text x="310" y="95" text-anchor="middle" fill="var(--text-secondary)" font-size="20">👨‍⚕️</text>
      <text x="340" y="95" text-anchor="middle" fill="var(--text-secondary)" font-size="20">⚖️</text>
      <text x="370" y="95" text-anchor="middle" fill="var(--text-secondary)" font-size="20">💻</text>
      <text x="340" y="122" text-anchor="middle" fill="var(--text-primary)" font-size="15" font-weight="600">Human Reviewers</text>
      <text x="340" y="140" text-anchor="middle" fill="var(--text-secondary)" font-size="11">Verified experts</text>
    </g>

    <!-- Arrow 2 → 3 -->
    <path class="flow-arrow" d="M420 105 L490 105"
      stroke="url(#accentGradient)" stroke-width="2.5" fill="none"
      marker-end="url(#arrowhead)" />

    <!-- Box 3: HumanJudge -->
    <g class="flow-box flow-box-3">
      <rect x="490" y="60" width="160" height="90" rx="12"
        fill="var(--bg-surface-elevated)"
        stroke="var(--color-accent)"
        stroke-width="2" />
      <text x="570" y="100" text-anchor="middle" fill="var(--color-accent)" font-size="15" font-weight="700">HumanJudge</text>
      <text x="570" y="122" text-anchor="middle" fill="var(--text-secondary)" font-size="12">Scores & Reports</text>
    </g>

    <!-- Feedback Loop Arrow (continuously animated) -->
    <path class="flow-loop"
      d="M570 150 L570 185 L110 185 L110 150"
      stroke="var(--color-accent)" stroke-width="2" fill="none"
      stroke-dasharray="8,4" opacity="0.6" />

    <!-- Loop label -->
    <text x="340" y="203" text-anchor="middle" fill="var(--text-secondary)" font-size="11">Continuous feedback loop</text>
  </svg>
</div>

<style>
  .flow-diagram {
    padding: 1rem 0;
  }

  /* Initial fade-in for boxes */
  .flow-box {
    opacity: 0;
    animation: fadeInBox 0.6s ease-out forwards;
  }

  .flow-box-1 { animation-delay: 0.1s; }
  .flow-box-2 { animation-delay: 0.4s; }
  .flow-box-3 { animation-delay: 0.7s; }

  @keyframes fadeInBox {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Arrows fade in */
  .flow-arrow {
    opacity: 0;
    animation: fadeIn 0.4s ease-out forwards;
  }

  .flow-arrow:nth-of-type(1) { animation-delay: 0.3s; }
  .flow-arrow:nth-of-type(2) { animation-delay: 0.6s; }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  /* Continuous loop animation */
  .flow-loop {
    animation: dashMove 1.5s linear infinite;
  }

  @keyframes dashMove {
    from {
      stroke-dashoffset: 0;
    }
    to {
      stroke-dashoffset: -24;
    }
  }

  /* Subtle pulse on HumanJudge box */
  .flow-box-3 rect {
    animation: pulseBorder 3s ease-in-out infinite;
    animation-delay: 1s;
  }

  @keyframes pulseBorder {
    0%, 100% {
      stroke-opacity: 1;
    }
    50% {
      stroke-opacity: 0.5;
    }
  }
</style>
